---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';

interface Props {
  lang: 'en' | 'de';
  title: string;
  description: string;
  eyebrow: string;
  heroTitle: string;
  image: string;
  imageAlt: string;
  suitableFor: string[];
  scope: string[];
  outcomes: { title: string; text: string }[];
  architecture: { title: string; text: string }[];
}

const {
  lang,
  title,
  description,
  eyebrow,
  heroTitle,
  image,
  imageAlt,
  suitableFor,
  scope,
  outcomes,
  architecture
} = Astro.props;

const isDe = lang === 'de';

const copy = isDe
  ? {
      back: 'Alle Salesforce-Leistungen',
      backHref: '/de/leistungen/#salesforce',
      primaryCta: 'Architektur besprechen',
      suitable: 'Geeignet für',
      scope: 'Leistungsumfang',
      scopeTitle: 'Architektur für Integration, Governance und zuverlässigen Betrieb.',
      outcomes: 'Geschäftlicher Nutzen',
      principles: 'Architekturprinzipien',
      principlesTitle: 'Ein belastbares System statt einer isolierten CRM-Konfiguration.',
      next: 'Nächster Schritt',
      nextTitle: 'Besprechen wir Ihre Zielarchitektur.',
      finalCta: 'Strategiegespräch buchen'
    }
  : {
      back: 'All Salesforce services',
      backHref: '/services/#salesforce',
      primaryCta: 'Discuss your architecture',
      suitable: 'Suitable for',
      scope: 'Implementation scope',
      scopeTitle: 'Architecture for integration, governance, and dependable operations.',
      outcomes: 'Business outcomes',
      principles: 'Architecture principles',
      principlesTitle: 'A dependable operating system, not an isolated CRM configuration.',
      next: 'Next step',
      nextTitle: 'Discuss your target architecture with NexaForce Digital.',
      finalCta: 'Book a strategy call'
    };

const whatsappMessage = isDe
  ? `Hallo NexaForce Digital, ich möchte ${title} besprechen.`
  : `Hello NexaForce Digital, I would like to discuss ${title}.`;
---

<BaseLayout title={title} description={description}>
  <Navbar />

  <main class="pt-32 pb-24">
    <section class="mx-auto max-w-7xl px-6 pb-20">
      <a
        href={copy.backHref}
        class="mb-8 inline-flex items-center gap-2 text-sm font-medium text-brand-steel transition-colors hover:text-brand-blue"
      >
        <span>←</span>
        {copy.back}
      </a>

      <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr]">
        <div>
          <p class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-brand-blue">
            {eyebrow}
          </p>

          <h1 class="max-w-4xl text-4xl font-extrabold leading-tight md:text-6xl">
            {heroTitle}
          </h1>

          <p class="mt-6 max-w-3xl text-lg leading-relaxed text-brand-steel">
            {description}
          </p>

          <a
            href={`https://wa.me/4917632246090?text=${encodeURIComponent(whatsappMessage)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-9 inline-flex rounded-full bg-brand-blue px-7 py-4 font-semibold text-white transition-colors hover:bg-blue-500"
          >
            {copy.primaryCta}
          </a>
        </div>

        <aside class="relative overflow-hidden rounded-3xl border border-brand-blue/25 bg-gradient-to-br from-brand-blue/15 via-[#13213d] to-violet-500/10 p-6 sm:p-8">
          <div class="pointer-events-none absolute -right-20 -top-20 h-56 w-56 rounded-full bg-brand-blue/20 blur-3xl"></div>
          <div class="pointer-events-none absolute -bottom-20 -left-20 h-56 w-56 rounded-full bg-violet-500/20 blur-3xl"></div>

          <div class="relative">
            <div class="flex min-h-[280px] items-center justify-center rounded-2xl border border-white/10 bg-[#0b1220]/75 p-10">
              <img
                src={image}
                alt={imageAlt}
                class="max-h-56 w-full object-contain drop-shadow-2xl"
              />
            </div>

            <div class="mt-7">
              <p class="mb-4 text-xs font-semibold uppercase tracking-[0.16em] text-brand-blue">
                {copy.suitable}
              </p>

              <ul class="space-y-3 text-sm leading-relaxed text-brand-steel">
                {suitableFor.map((item) => (
                  <li class="flex gap-3">
                    <span class="text-brand-blue">✓</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <section class="border-y border-white/8 bg-white/[0.025] py-20">
      <div class="mx-auto grid max-w-7xl gap-12 px-6 lg:grid-cols-[1.15fr_0.85fr]">
        <div>
          <p class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-brand-blue">
            {copy.scope}
          </p>

          <h2 class="mb-8 text-3xl font-bold">
            {copy.scopeTitle}
          </h2>

          <ul class="space-y-4">
            {scope.map((item) => (
              <li class="flex gap-3 text-sm leading-relaxed text-brand-steel">
                <span class="mt-0.5 text-brand-blue">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-2xl border border-white/10 bg-brand-dark p-8">
          <p class="mb-6 text-xs font-semibold uppercase tracking-[0.18em] text-brand-blue">
            {copy.outcomes}
          </p>

          <div class="space-y-8">
            {outcomes.map((outcome) => (
              <div>
                <p class="text-2xl font-bold text-white">{outcome.title}</p>
                <p class="mt-2 text-sm leading-relaxed text-brand-steel">
                  {outcome.text}
                </p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 py-24">
      <p class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-brand-blue">
        {copy.principles}
      </p>

      <h2 class="max-w-3xl text-3xl font-bold">
        {copy.principlesTitle}
      </h2>

      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {architecture.map((item) => (
          <article class="rounded-2xl border border-white/10 bg-white/[0.03] p-6">
            <h3 class="mb-3 text-lg font-bold text-white">{item.title}</h3>
            <p class="text-sm leading-relaxed text-brand-steel">{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mx-auto max-w-5xl px-6">
      <div class="rounded-3xl border border-brand-blue/25 bg-gradient-to-br from-brand-blue/15 to-violet-500/10 p-8 text-center md:p-12">
        <p class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-brand-blue">
          {copy.next}
        </p>

        <h2 class="mx-auto max-w-3xl text-3xl font-bold md:text-4xl">
          {copy.nextTitle}
        </h2>

        <a
          href={`https://wa.me/4917632246090?text=${encodeURIComponent(whatsappMessage)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-flex rounded-full bg-brand-blue px-8 py-4 font-semibold text-white transition-colors hover:bg-blue-500"
        >
          {copy.finalCta}
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
