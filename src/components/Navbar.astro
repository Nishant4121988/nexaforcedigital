---
import { getLangFromUrl, useTranslations } from '../i18n/ui';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const base = lang === 'en' ? '' : '/de';
const altPath = lang === 'en' ? '/de/' : '/';
---
<header class="fixed top-0 left-0 right-0 z-40 bg-brand-dark/90 backdrop-blur-md border-b border-white/5">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href={`${base}/`} class="flex items-center gap-3">
      <span class="text-xl font-bold text-white">Nexa<span class="text-brand-blue">Force</span> <span class="text-brand-steel font-medium">Digital</span></span>
    </a>
    <nav class="hidden md:flex items-center gap-8">
      <a href={`${base}/`} class="text-brand-steel hover:text-white transition-colors text-sm">{t('nav.home')}</a>
      <a
        href={lang === 'de' ? '/de/leistungen/' : '/services/'}
        class="text-brand-steel hover:text-white transition-colors text-sm"
      >
        {t('nav.services')}
      </a>
      <a href={`${base}/#contact`} class="text-brand-steel hover:text-white transition-colors text-sm">{t('nav.contact')}</a>
    </nav>
    <div class="flex items-center gap-4">
      <a href={altPath} class="text-xs text-brand-steel hover:text-white border border-white/10 rounded-full px-3 py-1 transition-colors">
        {lang === 'en' ? 'DE' : 'EN'}
      </a>
      <a
        href={`${base}/#contact`}
        class="bg-brand-blue hover:bg-blue-500 text-white text-sm font-medium px-5 py-2 rounded-full transition-colors"
      >
        {t('hero.cta.primary')}
      </a>
    </div>
  </div>
</header>
