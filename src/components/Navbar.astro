---
import { getLangFromUrl, useTranslations } from '../i18n/ui';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const base = lang === 'en' ? '' : '/de';
const altPath = lang === 'en' ? '/de/' : '/';
---
<header class="fixed top-0 left-0 right-0 z-40 bg-brand-dark/90 backdrop-blur-md border-b border-white/5">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href={`${base}/`} class="flex items-center gap-3">
      <span class="text-xl font-bold text-white">Nexa<span class="text-brand-blue">Force</span> <span class="text-brand-steel font-medium">Digital</span></span>
    </a>
    <nav class="hidden md:flex items-center gap-8">
      <a href={`${base}/`} class="text-brand-steel hover:text-white transition-colors text-sm">{t('nav.home')}</a>
      <a
        href={lang === 'de' ? '/de/leistungen/' : '/services/'}
        class="text-brand-steel hover:text-white transition-colors text-sm"
      >
        {t('nav.services')}
      </a>
      <a href={`${base}/#contact`} class="text-brand-steel hover:text-white transition-colors text-sm">{t('nav.contact')}</a>
    </nav>
    <div class="flex items-center gap-4">
      <!-- Light / Dark theme toggle (sun = switch to light, moon = switch to dark) -->
      <button
        id="theme-toggle"
        type="button"
        aria-label={lang === 'de' ? 'Zwischen hellem und dunklem Design wechseln' : 'Switch between light and dark theme'}
        title={lang === 'de' ? 'Hell-/Dunkelmodus wechseln' : 'Toggle light / dark mode'}
        class="flex items-center justify-center w-9 h-9 rounded-full border border-white/10 text-brand-steel hover:text-white hover:border-brand-blue/60 transition-colors"
      >
        <!-- Sun icon: visible in dark mode -->
        <svg class="theme-icon-sun h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
        </svg>
        <!-- Moon icon: visible in light mode -->
        <svg class="theme-icon-moon h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
        </svg>
      </button>
      <a href={altPath} class="text-xs text-brand-steel hover:text-white border border-white/10 rounded-full px-3 py-1 transition-colors">
        {lang === 'en' ? 'DE' : 'EN'}
      </a>
      <a
        href={`${base}/#contact`}
        class="bg-brand-blue hover:bg-blue-500 text-white text-sm font-medium px-5 py-2 rounded-full transition-colors"
      >
        {t('hero.cta.primary')}
      </a>
    </div>
  </div>
</header>
