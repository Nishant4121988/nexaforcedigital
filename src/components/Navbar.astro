---
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const base = lang === 'en' ? '' : '/de';
const altPath = lang === 'en' ? '/de/' : '/';
---

<header class="fixed top-0 left-0 right-0 z-40 border-b border-white/5 bg-brand-dark/90 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-3">
    <!-- Brand -->
    <a
      href={`${base}/`}
      class="group flex items-center gap-3"
      aria-label="NexaForce Digital home"
    >
      <img
        src="/images/nexaforce-digital-logo.jpg"
        alt="NexaForce Digital"
        width="60"
        height="60"
        class="h-12 w-12 rounded-xl border border-brand-blue/20 object-cover shadow-lg shadow-brand-blue/10 transition-transform duration-300 group-hover:scale-105"
      />

      <span class="hidden text-lg font-bold tracking-tight text-white sm:block">
        Nexa<span class="text-brand-blue">Force</span>
        <span class="font-medium text-brand-steel">Digital</span>
      </span>
    </a>

    <!-- Desktop navigation -->
    <nav class="hidden items-center gap-8 md:flex" aria-label="Primary navigation">
      <a
        href={`${base}/`}
        class="text-sm text-brand-steel transition-colors hover:text-white"
      >
        {t('nav.home')}
      </a>

      <a
        href={lang === 'de' ? '/de/leistungen/' : '/services/'}
        class="text-sm text-brand-steel transition-colors hover:text-white"
      >
        {t('nav.services')}
      </a>

      <a
        href={`${base}/#contact`}
        class="text-sm text-brand-steel transition-colors hover:text-white"
      >
        {t('nav.contact')}
      </a>
    </nav>

    <!-- Language and CTA -->
    <div class="flex items-center gap-3 sm:gap-4">
      <a
        href={altPath}
        class="rounded-full border border-white/10 px-3 py-1 text-xs text-brand-steel transition-colors hover:text-white"
        aria-label={lang === 'en' ? 'Switch to German' : 'Switch to English'}
      >
        {lang === 'en' ? 'DE' : 'EN'}
      </a>

      <a
        href="https://wa.me/4917632246090?text=Hello%20NexaForce%20Digital%2C%20I%20would%20like%20to%20book%20a%20strategy%20call."
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full bg-brand-blue px-4 py-2 text-xs font-medium text-white transition-colors hover:bg-blue-500 sm:px-5 sm:text-sm"
      >
        {t('hero.cta.primary')}
      </a>
    </div>
  </div>
</header>
