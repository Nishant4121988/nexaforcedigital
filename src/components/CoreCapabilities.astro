<!-- ===================== CLIENT-SIDE TAB LOGIC ===================== -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {

    // ── TOP-LEVEL TABS ──────────────────────────────────────────────
    const topBtns = document.querySelectorAll('.top-tab-btn');
    const topPanels = document.querySelectorAll('.tab-panel');

    topBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        const target = btn.getAttribute('data-tab');

        topBtns.forEach(function (b) {
          b.classList.remove('active-top-tab');
          b.setAttribute('aria-selected', 'false');
        });
        topPanels.forEach(function (p) { p.classList.add('hidden'); });

        btn.classList.add('active-top-tab');
        btn.setAttribute('aria-selected', 'true');
        var panel = document.getElementById('panel-' + target);
        if (panel) panel.classList.remove('hidden');
      });
    });

    // ── SUB-TABS (SALESFORCE) ────────────────────────────────────────
    const subBtns = document.querySelectorAll('.sub-tab-btn');

    subBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        const targetSub = btn.getAttribute('data-subtab');
        const group = btn.getAttribute('data-group');

        // Deactivate all buttons in this group
        document.querySelectorAll('.sub-tab-btn[data-group="' + group + '"]').forEach(function (b) {
          b.classList.remove('active-sub-tab');
          b.setAttribute('aria-selected', 'false');
        });

        // Hide all sub-panels in this group
        document.querySelectorAll('.sub-panel[data-group="' + group + '"]').forEach(function (p) {
          p.classList.add('hidden');
        });

        // Activate clicked
        btn.classList.add('active-sub-tab');
        btn.setAttribute('aria-selected', 'true');
        var subPanel = document.getElementById('sub-' + targetSub);
        if (subPanel) subPanel.classList.remove('hidden');
      });
    });

  });
</script>
