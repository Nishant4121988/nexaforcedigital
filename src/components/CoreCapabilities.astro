---
interface Props {
  lang?: 'en' | 'de';
}

const { lang = 'en' } = Astro.props;

const isDe = lang === 'de';

const copy = isDe
  ? {
      eyebrow: 'WAS WIR ENTWICKELN',
      heading: 'Kernkompetenzen',
      intro:
        'Drei integrierte Engineering-Disziplinen. Ein einheitlicher Lieferstandard. Jedes Projekt wird für Skalierbarkeit, Datensouveränität und messbaren Nutzen entwickelt.',
      salesforce: 'Enterprise Salesforce CRM',
      n8n: 'Intelligente n8n-Automatisierung',
      ai: 'Enterprise KI & Multi-Agenten',
      revenue: 'Revenue Cloud (CPQ & Billing)',
      clm: 'Contract Lifecycle (CLM)',
      commerce: 'Commerce Cloud',
      data: 'Data Cloud & Core Platform',
      health: 'Health Cloud',
      financial: 'Financial Services Cloud',
      explore: 'Leistung ansehen',
      healthHref: '/de/leistungen/health-cloud',
      financialHref: '/de/leistungen/financial-services-cloud'
    }
  : {
      eyebrow: 'WHAT WE BUILD',
      heading: 'Core Capabilities',
      intro:
        'Three integrated engineering disciplines. One unified delivery standard. Every engagement is architected for scale, sovereignty, and measurable return.',
      salesforce: 'Enterprise Salesforce CRM',
      n8n: 'Intelligent n8n Automation',
      ai: 'Enterprise AI & Multi-Agent',
      revenue: 'Revenue Cloud (CPQ & Billing)',
      clm: 'Contract Lifecycle (CLM)',
      commerce: 'Commerce Cloud',
      data: 'Data Cloud & Core Platform',
      health: 'Health Cloud',
      financial: 'Financial Services Cloud',
      explore: 'Explore service',
      healthHref: '/services/health-cloud',
      financialHref: '/services/financial-services-cloud'
    };
---

<section id="core-capabilities" class="bg-[#0F172A] px-4 py-24 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <div class="mb-14 text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-violet-400">
        {copy.eyebrow}
      </p>

      <h2 class="text-4xl font-bold leading-tight text-[#F8FAFC] sm:text-5xl">
        {copy.heading}
      </h2>

      <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-slate-400">
        {copy.intro}
      </p>
    </div>

    <!-- Top-level tabs -->
    <div
      class="mb-10 flex flex-wrap justify-center gap-2"
      role="tablist"
      aria-label="Core capabilities"
    >
      <button
        type="button"
        data-tab="salesforce"
        role="tab"
        aria-selected="true"
        aria-controls="panel-salesforce"
        class="top-tab-btn active-top-tab flex items-center gap-2 rounded-lg border border-slate-700 px-5 py-3 text-sm font-semibold transition-all duration-200"
      >
        <img src="/assets/logos/crm/data-cloud.svg" alt="" class="h-5 w-5" aria-hidden="true" />
        {copy.salesforce}
      </button>

      <button
        type="button"
        data-tab="n8n"
        role="tab"
        aria-selected="false"
        aria-controls="panel-n8n"
        class="top-tab-btn flex items-center gap-2 rounded-lg border border-slate-700 px-5 py-3 text-sm font-semibold transition-all duration-200"
      >
        <img src="/assets/logos/n8n/n8n-logo.svg" alt="" class="h-5 w-5" aria-hidden="true" />
        {copy.n8n}
      </button>

      <button
        type="button"
        data-tab="ai"
        role="tab"
        aria-selected="false"
        aria-controls="panel-ai"
        class="top-tab-btn flex items-center gap-2 rounded-lg border border-slate-700 px-5 py-3 text-sm font-semibold transition-all duration-200"
      >
        <img src="/assets/logos/ai/langgraph.svg" alt="" class="h-5 w-5" aria-hidden="true" />
        {copy.ai}
      </button>
    </div>

    <!-- Salesforce -->
    <div
      id="panel-salesforce"
      data-panel="salesforce"
      role="tabpanel"
      class="tab-panel rounded-2xl border border-slate-800 bg-[#0F1929] p-6 sm:p-8"
    >
      <div
        class="mb-8 flex flex-wrap gap-2 border-b border-slate-800 pb-5"
        role="tablist"
        aria-label="Salesforce domains"
      >
        <button type="button" data-subtab="revenue" data-group="sf" role="tab" aria-selected="true" class="sub-tab-btn sf-sub active-sub-tab">
          {copy.revenue}
        </button>

        <button type="button" data-subtab="clm" data-group="sf" role="tab" aria-selected="false" class="sub-tab-btn sf-sub">
          {copy.clm}
        </button>

        <button type="button" data-subtab="commerce" data-group="sf" role="tab" aria-selected="false" class="sub-tab-btn sf-sub">
          {copy.commerce}
        </button>

        <button type="button" data-subtab="data" data-group="sf" role="tab" aria-selected="false" class="sub-tab-btn sf-sub">
          {copy.data}
        </button>

        <button type="button" data-subtab="health" data-group="sf" role="tab" aria-selected="false" class="sub-tab-btn sf-sub">
          {copy.health}
        </button>

        <button type="button" data-subtab="financial" data-group="sf" role="tab" aria-selected="false" class="sub-tab-btn sf-sub">
          {copy.financial}
        </button>
      </div>

      <!-- Revenue -->
      <div id="sub-revenue" data-subpanel="revenue" data-group="sf" class="sub-panel">
        <div class="space-y-6">
          <div>
            <h3 class="mb-2 text-xl font-bold text-[#F8FAFC]">
              Revenue Cloud — CPQ & Automated Billing
            </h3>
            <p class="text-sm leading-relaxed text-slate-400">
              We architect end-to-end Quote-to-Cash pipelines for complex product
              catalogs, bundle rules, guided selling, pricing governance,
              subscription billing, and ERP-connected revenue operations.
            </p>
          </div>

          <div>
            <h4 class="mb-3 text-xs font-semibold uppercase tracking-widest text-violet-400">
              Core Deliverables
            </h4>
            <ul class="grid gap-2 text-sm text-slate-300 sm:grid-cols-2">
              <li>▹ Advanced Apex price rules and Quote Calculator Plugins</li>
              <li>▹ Guided selling with dependency-driven conditional logic</li>
              <li>▹ ERP and billing integration with governed data synchronization</li>
              <li>▹ Subscription lifecycle and automated renewal processing</li>
              <li>▹ Revenue-recognition workflow support</li>
              <li>▹ Multi-currency and multi-region pricing architecture</li>
            </ul>
          </div>

          <div class="grid gap-4 pt-2 sm:grid-cols-3">
            <div class="metric-card">
              <p class="text-2xl font-extrabold text-blue-400">40%</p>
              <p>Faster quote generation</p>
            </div>
            <div class="metric-card">
              <p class="text-2xl font-extrabold text-violet-400">100%</p>
              <p>Pricing error prevention target</p>
            </div>
            <div class="metric-card">
              <p class="text-2xl font-extrabold text-blue-400">Zero</p>
              <p>Uncontrolled CPQ-to-ERP leakage</p>
            </div>
          </div>
        </div>
      </div>

      <!-- CLM -->
      <div id="sub-clm" data-subpanel="clm" data-group="sf" class="sub-panel hidden">
        <div class="space-y-6">
          <div>
            <h3 class="mb-2 text-xl font-bold text-[#F8FAFC]">
              Salesforce Contract Lifecycle Management
            </h3>
            <p class="text-sm leading-relaxed text-slate-400">
              We connect approved commercial terms to controlled contract generation,
              negotiation, e-signature, obligations, and renewal operations.
            </p>
          </div>

          <ul class="grid gap-2 text-sm text-slate-300 sm:grid-cols-2">
            <li>▹ Contract generation from CPQ quote records</li>
            <li>▹ Governed clause libraries and template management</li>
            <li>▹ Redlining workflows with legal and sales controls</li>
            <li>▹ DocuSign and Adobe Sign integrations</li>
            <li>▹ Renewal alerts and obligation tracking</li>
            <li>▹ Contract lifecycle reporting and auditability</li>
          </ul>
        </div>
      </div>

      <!-- Commerce -->
      <div id="sub-commerce" data-subpanel="commerce" data-group="sf" class="sub-panel hidden">
        <div class="space-y-6">
          <div>
            <h3 class="mb-2 text-xl font-bold text-[#F8FAFC]">
              Salesforce Commerce Cloud
            </h3>
            <p class="text-sm leading-relaxed text-slate-400">
              B2B, B2C, and D2C commerce architecture spanning storefronts,
              pricing, cart and checkout flows, payments, orders, inventory,
              subscriptions, and ERP integration.
            </p>
          </div>

          <div class="grid gap-4 sm:grid-cols-3">
            <article class="domain-card">
              <h4>B2B Commerce</h4>
              <p>Account hierarchies, contract pricing, quick order, PO checkout, and ERP inventory synchronization.</p>
            </article>

            <article class="domain-card">
              <h4>B2C Commerce</h4>
              <p>Headless storefronts, payments, personalized journeys, performant APIs, and conversion-focused checkout.</p>
            </article>

            <article class="domain-card">
              <h4>D2C Commerce</h4>
              <p>Subscriptions, loyalty, direct fulfillment, unified inventory, and first-party customer data capture.</p>
            </article>
          </div>
        </div>
      </div>

      <!-- Data -->
      <div id="sub-data" data-subpanel="data" data-group="sf" class="sub-panel hidden">
        <div class="space-y-6">
          <div>
            <h3 class="mb-2 text-xl font-bold text-[#F8FAFC]">
              Salesforce Data Cloud & Core Platform
            </h3>
            <p class="text-sm leading-relaxed text-slate-400">
              We implement Data Cloud as a governed intelligence layer for
              real-time ingestion, identity resolution, unified profiles,
              segment activation, and CRM optimization.
            </p>
          </div>

          <ul class="grid gap-2 text-sm text-slate-300 sm:grid-cols-2">
            <li>▹ Real-time streaming and batch ingestion</li>
            <li>▹ Identity resolution and unified customer profiles</li>
            <li>▹ Zero-copy patterns with Snowflake and BigQuery</li>
            <li>▹ Segment-triggered Flow and cross-cloud activation</li>
            <li>▹ Calculated Insights for operational KPIs</li>
            <li>▹ Governed data access and lifecycle controls</li>
          </ul>
        </div>
      </div>

      <!-- Health -->
      <div id="sub-health" data-subpanel="health" data-group="sf" class="sub-panel hidden">
        <div class="space-y-6">
          <div>
            <h3 class="mb-2 text-xl font-bold text-[#F8FAFC]">
              Salesforce Health Cloud
            </h3>
            <p class="text-sm leading-relaxed text-slate-400">
              Connected care operations, patient service workflows, and controlled
              EHR/EMR interoperability for organizations that require dependable
              coordination, traceable access, and governed processes.
            </p>
          </div>

          <div>
            <h4 class="mb-3 text-xs font-semibold uppercase tracking-widest text-violet-400">
              Core Deliverables
            </h4>
            <ul class="grid gap-2 text-sm text-slate-300 sm:grid-cols-2">
              <li>▹ Care plans, cases, referrals, and patient-service workflows</li>
              <li>▹ REST, FHIR, HL7, and middleware integration patterns</li>
              <li>▹ Role-based access, audit trails, and consent-aware processes</li>
              <li>▹ Provider and patient communication with SLA escalation</li>
            </ul>
          </div>

          <a href={copy.healthHref} class="inline-flex items-center gap-2 text-sm font-semibold text-blue-400 hover:underline">
            {copy.explore} →
          </a>
        </div>
      </div>

      <!-- Financial Services: THIS MATCHES data-subtab="financial" -->
      <div id="sub-financial" data-subpanel="financial" data-group="sf" class="sub-panel hidden">
        <div class="space-y-6">
          <div>
            <h3 class="mb-2 text-xl font-bold text-[#F8FAFC]">
              Salesforce Financial Services Cloud
            </h3>
            <p class="text-sm leading-relaxed text-slate-400">
              Financial 360 architecture for regulated client operations,
              including onboarding, relationship management, service workflows,
              audit controls, and financial-system integration.
            </p>
          </div>

          <div>
            <h4 class="mb-3 text-xs font-semibold uppercase tracking-widest text-violet-400">
              Core Deliverables
            </h4>
            <ul class="grid gap-2 text-sm text-slate-300 sm:grid-cols-2">
              <li>▹ Financial account, household, relationship, and interaction models</li>
              <li>▹ Client onboarding and KYC-supporting process workflows</li>
              <li>▹ Financial 360 views and advisor workflow orchestration</li>
              <li>▹ Core banking, portfolio, document, and e-signature integration</li>
              <li>▹ Role-based access, approvals, and audit controls</li>
              <li>▹ Operational reporting for regulated service processes</li>
            </ul>
          </div>

          <a href={copy.financialHref} class="inline-flex items-center gap-2 text-sm font-semibold text-blue-400 hover:underline">
            {copy.explore} →
          </a>
        </div>
      </div>
    </div>

    <!-- n8n -->
    <div
      id="panel-n8n"
      data-panel="n8n"
      role="tabpanel"
      class="tab-panel hidden rounded-2xl border border-slate-800 bg-[#0F1929] p-6 sm:p-8"
    >
      <h3 class="mb-3 text-xl font-bold text-[#F8FAFC]">Intelligent n8n Workflow Automation</h3>
      <p class="max-w-4xl text-sm leading-relaxed text-slate-400">
        Secure self-hosted and cloud n8n workflow architecture: custom nodes,
        webhook orchestration, API integration, payload transformation, retries,
        queues, rate-limit handling, secrets isolation, and execution audit trails.
      </p>
    </div>

    <!-- AI -->
    <div
      id="panel-ai"
      data-panel="ai"
      role="tabpanel"
      class="tab-panel hidden rounded-2xl border border-slate-800 bg-[#0F1929] p-6 sm:p-8"
    >
      <h3 class="mb-3 text-xl font-bold text-[#F8FAFC]">Enterprise AI & Multi-Agent Systems</h3>
      <p class="max-w-4xl text-sm leading-relaxed text-slate-400">
        Production systems built with LangChain and LangGraph for stateful agent
        orchestration, RAG, governed tool use, observability, Human-in-the-Loop
        checkpoints, secure APIs, and client-controlled data infrastructure.
      </p>
    </div>
  </div>
</section>

<style>
  .top-tab-btn {
    background-color: transparent;
    color: #94a3b8;
  }

  .top-tab-btn:hover {
    background-color: #1e293b;
    color: #f8fafc;
  }

  .active-top-tab {
    background: linear-gradient(135deg, #1e40af22, #7c3aed22);
    border-color: #6366f1 !important;
    color: #f8fafc;
  }

  .sub-tab-btn {
    background-color: transparent;
    border: 1px solid #334155;
    border-radius: 0.375rem;
    color: #94a3b8;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1rem;
    padding: 0.5rem 0.75rem;
    transition: all 150ms ease;
  }

  .sub-tab-btn:hover {
    background-color: #1e293b;
    color: #f8fafc;
  }

  .active-sub-tab {
    background-color: #1e293b;
    border-color: #3b82f6 !important;
    color: #f8fafc;
  }

  .metric-card {
    border: 1px solid #334155;
    border-radius: 0.75rem;
    background: rgb(30 41 59 / 0.6);
    padding: 1rem;
    text-align: center;
  }

  .metric-card p:last-child {
    margin-top: 0.25rem;
    color: #94a3b8;
    font-size: 0.75rem;
  }

  .domain-card {
    border: 1px solid #334155;
    border-radius: 0.75rem;
    background: rgb(30 41 59 / 0.35);
    padding: 1rem;
  }

  .domain-card h4 {
    color: #60a5fa;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .domain-card p {
    margin-top: 0.5rem;
    color: #94a3b8;
    font-size: 0.75rem;
    line-height: 1.25rem;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const topButtons = document.querySelectorAll('.top-tab-btn');
    const topPanels = document.querySelectorAll('.tab-panel');

    topButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const target = button.getAttribute('data-tab');

        topButtons.forEach((item) => {
          item.classList.remove('active-top-tab');
          item.setAttribute('aria-selected', 'false');
        });

        topPanels.forEach((panel) => panel.classList.add('hidden'));

        button.classList.add('active-top-tab');
        button.setAttribute('aria-selected', 'true');

        const panel = document.getElementById(`panel-${target}`);
        if (panel) panel.classList.remove('hidden');
      });
    });

    const subButtons = document.querySelectorAll('.sub-tab-btn');

    subButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const target = button.getAttribute('data-subtab');
        const group = button.getAttribute('data-group');

        document
          .querySelectorAll(`.sub-tab-btn[data-group="${group}"]`)
          .forEach((item) => {
            item.classList.remove('active-sub-tab');
            item.setAttribute('aria-selected', 'false');
          });

        document
          .querySelectorAll(`.sub-panel[data-group="${group}"]`)
          .forEach((panel) => panel.classList.add('hidden'));

        button.classList.add('active-sub-tab');
        button.setAttribute('aria-selected', 'true');

        const panel = document.getElementById(`sub-${target}`);
        if (panel) panel.classList.remove('hidden');
      });
    });
  });
</script>
