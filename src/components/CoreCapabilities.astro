---
interface Props {
  lang?: 'en' | 'de';
}

const { lang = 'en' } = Astro.props;
const isDe = lang === 'de';

const labels = isDe
  ? {
      eyebrow: 'WAS WIR ENTWICKELN',
      title: 'Kernkompetenzen',
      intro:
        'Drei integrierte Engineering-Disziplinen. Ein einheitlicher Lieferstandard. Jedes Projekt wird für Skalierbarkeit, Datensouveränität und messbaren Nutzen entwickelt.',
      salesforce: 'Enterprise Salesforce CRM',
      n8n: 'Intelligente n8n-Automatisierung',
      ai: 'Enterprise KI & Multi-Agenten',
      core: 'KERNLEISTUNGEN',
      explore: 'Leistung ansehen',
      healthHref: '/de/leistungen/health-cloud/',
      financialHref: '/de/leistungen/financial-services-cloud/'
    }
  : {
      eyebrow: 'WHAT WE BUILD',
      title: 'Core Capabilities',
      intro:
        'Three integrated engineering disciplines. One unified delivery standard. Every engagement is architected for scale, sovereignty, and measurable return.',
      salesforce: 'Enterprise Salesforce CRM',
      n8n: 'Intelligent n8n Automation',
      ai: 'Enterprise AI & Multi-Agent',
      core: 'CORE DELIVERABLES',
      explore: 'Explore service',
      healthHref: '/services/health-cloud/',
      financialHref: '/services/financial-services-cloud/'
    };

const clouds = [
  {
    id: 'revenue',
    tab: isDe ? 'Revenue Cloud (CPQ & Billing)' : 'Revenue Cloud (CPQ & Billing)',
    image: '/assets/logos/crm/revenue-cloud.svg',
    alt: 'Salesforce Revenue Cloud',
    title: isDe
      ? 'Revenue Cloud — CPQ & automatisierte Abrechnung'
      : 'Revenue Cloud — CPQ & Automated Billing',
    description: isDe
      ? 'End-to-End Quote-to-Cash-Architektur für komplexe Produktkataloge, Bundles, Preisregeln, Guided Selling, Subscriptions und kontrollierte ERP-Integration.'
      : 'End-to-end Quote-to-Cash architecture for complex product catalogs, bundles, pricing rules, guided selling, subscriptions, and governed ERP integration.',
    deliverables: isDe
      ? [
          'Apex Price Rules und Custom Quote Calculator Plugins',
          'Guided Selling mit abhängigen Entscheidungslogiken',
          'ERP- und Billing-Integration mit kontrollierter Datensynchronisation',
          'Subscription Lifecycle und automatisierte Verlängerungen',
          'Unterstützung für Revenue-Recognition-Prozesse',
          'Multi-Währung- und Multi-Region-Preisarchitektur'
        ]
      : [
          'Apex Price Rules and Custom Quote Calculator Plugins',
          'Guided selling with dependency-driven conditional logic',
          'ERP and billing integration with governed synchronization',
          'Subscription lifecycle and automated renewals',
          'Revenue-recognition workflow support',
          'Multi-currency and multi-region pricing architecture'
        ],
    metrics: isDe
      ? [
          { value: '40%', label: 'schnellere Angebotserstellung' },
          { value: '100%', label: 'Ziel: keine Preisfehler' },
          { value: 'Zero', label: 'unkontrollierte CPQ-zu-ERP-Abweichungen' }
        ]
      : [
          { value: '40%', label: 'faster quote generation' },
          { value: '100%', label: 'pricing-error prevention target' },
          { value: 'Zero', label: 'uncontrolled CPQ-to-ERP leakage' }
        ]
  },
  {
    id: 'clm',
    tab: 'Contract Lifecycle (CLM)',
    image: '/assets/logos/crm/clm.svg',
    alt: 'Salesforce Contract Lifecycle Management',
    title: isDe ? 'Contract Lifecycle Management' : 'Contract Lifecycle Management',
    description: isDe
      ? 'Kontrollierte Prozesse für Vertragserstellung, Klauselbibliotheken, Verhandlungen, E-Signaturen, Verpflichtungen und Verlängerungen.'
      : 'Controlled contract generation, clause libraries, negotiation, e-signature, obligations, and renewal operations connected to commercial data.',
    deliverables: isDe
      ? [
          'Vertragserstellung aus CPQ- und Opportunity-Daten',
          'Klauselbibliotheken und kontrollierte Vorlagen',
          'Freigaben und Redlining für Legal und Sales',
          'DocuSign- und Adobe-Sign-Integration',
          'Renewal Alerts und Obligation Tracking',
          'Lifecycle Reporting und Auditierbarkeit'
        ]
      : [
          'Contract generation from CPQ and opportunity data',
          'Governed clause libraries and templates',
          'Approval and redlining workflows for legal and sales',
          'DocuSign and Adobe Sign integrations',
          'Renewal alerts and obligation tracking',
          'Lifecycle reporting and auditability'
        ]
  },
  {
    id: 'commerce',
    tab: 'Commerce Cloud',
    image: '/assets/logos/crm/commerce-cloud.svg',
    alt: 'Salesforce Commerce Cloud',
    title: isDe ? 'Salesforce Commerce Cloud' : 'Salesforce Commerce Cloud',
    description: isDe
      ? 'B2B-, B2C- und D2C-Commerce-Architektur für Storefronts, Preisgestaltung, Warenkorb, Checkout, Payments, Bestellungen, Bestand und Fulfillment.'
      : 'B2B, B2C, and D2C commerce architecture for storefronts, pricing, cart, checkout, payments, orders, inventory, and fulfillment.',
    deliverables: isDe
      ? [
          'B2B Account-Hierarchien und vertragsbasierte Preise',
          'Headless Storefronts und leistungsfähige Commerce APIs',
          'Checkout-, Payment- und Loyalty-Workflows',
          'Katalog-, Promotion-, Cart- und Subscription-Design',
          'ERP-, Inventory-, Tax- und Fulfillment-Integration',
          'Kontrolliertes kanalübergreifendes Order Management'
        ]
      : [
          'B2B account hierarchies and contract pricing',
          'Headless storefronts and performant commerce APIs',
          'Checkout, payment, and loyalty workflows',
          'Catalog, promotion, cart, and subscription design',
          'ERP, inventory, tax, and fulfillment integration',
          'Controlled multi-channel order management'
        ]
  },
  {
    id: 'data',
    tab: isDe ? 'Data Cloud & Core Platform' : 'Data Cloud & Core Platform',
    image: '/assets/logos/crm/data-cloud.svg',
    alt: 'Salesforce Data Cloud',
    title: isDe
      ? 'Salesforce Data Cloud & Core Platform'
      : 'Salesforce Data Cloud & Core Platform',
    description: isDe
      ? 'Kontrollierte Customer-Intelligence-Schicht für Echtzeit-Ingestion, Identity Resolution, einheitliche Profile, Segmentaktivierung und CRM-Optimierung.'
      : 'A governed customer-intelligence layer for real-time ingestion, identity resolution, unified profiles, segment activation, and CRM optimization.',
    deliverables: isDe
      ? [
          'Echtzeit- und Batch-Ingestion',
          'Identity Resolution und einheitliche Kundenprofile',
          'Zero-Copy-Architektur mit Snowflake und BigQuery',
          'Segment-getriggerte Flows und Cross-Cloud-Aktivierung',
          'Calculated Insights für operative KPIs',
          'Datenzugriff, Governance und Lifecycle Controls'
        ]
      : [
          'Real-time and batch ingestion',
          'Identity resolution and unified customer profiles',
          'Zero-copy architecture with Snowflake and BigQuery',
          'Segment-triggered Flows and cross-cloud activation',
          'Calculated Insights for operational KPIs',
          'Data access, governance, and lifecycle controls'
        ]
  },
  {
    id: 'health',
    tab: 'Health Cloud',
    image: '/assets/logos/crm/health-cloud.svg',
    alt: 'Salesforce Health Cloud',
    title: 'Salesforce Health Cloud',
    description: isDe
      ? 'Vernetzte Versorgungsprozesse, Patientenservice-Workflows und kontrollierte EHR/EMR-Interoperabilität für nachvollziehbare und zuverlässig betreibbare Prozesse.'
      : 'Connected care operations, patient-service workflows, and controlled EHR/EMR interoperability for traceable and dependable processes.',
    deliverables: isDe
      ? [
          'Care Plans, Cases, Referrals und Patientenservice-Workflows',
          'REST-, FHIR-, HL7- und Middleware-Integrationsmuster',
          'Rollenbasierte Berechtigungen und Audit Trails',
          'Consent-orientierte Prozessgestaltung',
          'Task Orchestration und SLA-Eskalationen',
          'Service- und Versorgungsanalysen'
        ]
      : [
          'Care plans, cases, referrals, and patient-service workflows',
          'REST, FHIR, HL7, and middleware integration patterns',
          'Role-based permissions and audit trails',
          'Consent-aware process design',
          'Task orchestration and SLA escalations',
          'Care and service operational analytics'
        ],
    href: labels.healthHref
  },
  {
    id: 'financial',
    tab: 'Financial Services Cloud',
    image: '/assets/logos/crm/financial-services-cloud.svg',
    alt: 'Salesforce Financial Services Cloud',
    title: 'Salesforce Financial Services Cloud',
    description: isDe
      ? 'Financial-360-Architektur für regulierte Kundenprozesse – von Onboarding und Relationship Management bis Service, Auditierung und Systemintegration.'
      : 'Financial 360 architecture for regulated client operations—from onboarding and relationship management to service, audit controls, and financial-system integration.',
    deliverables: isDe
      ? [
          'Financial Account-, Household- und Relationship-Datenmodelle',
          'Client Onboarding und KYC-unterstützende Prozesse',
          'Financial-360-Sicht und Advisor Workflow Orchestration',
          'Core-Banking-, Portfolio- und Dokumenten-Integration',
          'E-Signature-, Freigabe- und Auditkontrollen',
          'Reporting für regulierte Serviceprozesse'
        ]
      : [
          'Financial account, household, and relationship data models',
          'Client onboarding and KYC-supporting workflows',
          'Financial 360 views and advisor workflow orchestration',
          'Core banking, portfolio, and document integration',
          'E-signature, approvals, and audit controls',
          'Reporting for regulated service operations'
        ],
    href: labels.financialHref
  }
];
---

<section id="core-capabilities" class="bg-[#0f172a] px-4 py-24 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <header class="mx-auto mb-14 max-w-3xl text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.16em] text-violet-400">
        {labels.eyebrow}
      </p>

      <h2 class="text-4xl font-bold leading-tight text-white md:text-5xl">
        {labels.title}
      </h2>

      <p class="mt-4 text-base leading-relaxed text-slate-400 md:text-lg">
        {labels.intro}
      </p>
    </header>

    <div class="mb-10 flex flex-wrap justify-center gap-3" role="tablist" aria-label="Core capabilities">
      <button
        type="button"
        class="top-tab active-top-tab"
        data-top-tab="salesforce"
        role="tab"
        aria-selected="true"
      >
        <img
          src="/assets/logos/crm/data-cloud.svg"
          alt=""
          aria-hidden="true"
          class="h-5 w-5 object-contain"
        />
        <span>{labels.salesforce}</span>
      </button>

      <button
        type="button"
        class="top-tab"
        data-top-tab="n8n"
        role="tab"
        aria-selected="false"
      >
        <span class="text-base leading-none">⚙</span>
        <span>{labels.n8n}</span>
      </button>

      <button
        type="button"
        class="top-tab"
        data-top-tab="ai"
        role="tab"
        aria-selected="false"
      >
        <span class="text-base leading-none">✦</span>
        <span>{labels.ai}</span>
      </button>
    </div>

    <section
      data-top-panel="salesforce"
      class="top-panel rounded-2xl border border-slate-800 bg-[#101b2e] p-5 sm:p-8"
    >
      <div class="mb-8 flex flex-wrap gap-2 border-b border-slate-800 pb-5" role="tablist" aria-label="Salesforce clouds">
        {clouds.map((cloud, index) => (
          <button
            type="button"
            class:list={['cloud-tab', index === 0 && 'active-cloud-tab']}
            data-cloud-tab={cloud.id}
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
          >
            <img
              src={cloud.image}
              alt=""
              aria-hidden="true"
              class="h-5 w-5 shrink-0 object-contain"
            />
            <span>{cloud.tab}</span>
          </button>
        ))}
      </div>

      {clouds.map((cloud, index) => (
        <article
          data-cloud-panel={cloud.id}
          class:list={['cloud-panel', index !== 0 && 'hidden']}
        >
          <div class="grid gap-8 lg:grid-cols-[92px_1fr]">
            <div class="flex h-20 w-20 items-center justify-center rounded-2xl border border-brand-blue/25 bg-brand-blue/10 p-3">
              <img
                src={cloud.image}
                alt={cloud.alt}
                class="h-full w-full object-contain"
              />
            </div>

            <div>
              <h3 class="text-2xl font-bold text-white">
                {cloud.title}
              </h3>

              <p class="mt-3 max-w-5xl text-sm leading-relaxed text-slate-400 md:text-base">
                {cloud.description}
              </p>

              <h4 class="mb-4 mt-7 text-xs font-semibold uppercase tracking-[0.16em] text-violet-400">
                {labels.core}
              </h4>

              <ul class="grid gap-x-10 gap-y-3 text-sm leading-relaxed text-slate-200 md:grid-cols-2">
                {cloud.deliverables.map((item) => (
                  <li class="flex gap-3">
                    <span class="text-blue-400">▹</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>

              {cloud.href && (
                <a
                  href={cloud.href}
                  class="mt-7 inline-flex items-center gap-2 text-sm font-semibold text-brand-blue transition-colors hover:text-blue-300"
                >
                  {labels.explore}
                  <span>→</span>
                </a>
              )}

              {cloud.metrics && (
                <div class="mt-8 grid gap-4 sm:grid-cols-3">
                  {cloud.metrics.map((metric) => (
                    <div class="rounded-xl border border-slate-700 bg-slate-800/60 p-4 text-center">
                      <p class="text-2xl font-extrabold text-blue-400">{metric.value}</p>
                      <p class="mt-1 text-xs leading-relaxed text-slate-400">{metric.label}</p>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        </article>
      ))}
    </section>

    <section
      data-top-panel="n8n"
      class="top-panel hidden rounded-2xl border border-slate-800 bg-[#101b2e] p-8"
    >
      <h3 class="text-2xl font-bold text-white">
        {isDe ? 'Intelligente n8n-Automatisierung' : 'Intelligent n8n Workflow Automation'}
      </h3>

      <p class="mt-4 max-w-4xl text-base leading-relaxed text-slate-400">
        {isDe
          ? 'Sichere n8n-Workflow-Architektur für selbst gehostete und cloudbasierte Integrationen mit Custom Nodes, Webhooks, Queues, Retry-Logik, Secrets Management und Audit Trails.'
          : 'Secure n8n workflow architecture for self-hosted and cloud integration: custom nodes, webhooks, queues, retry logic, secrets management, and execution audit trails.'}
      </p>
    </section>

    <section
      data-top-panel="ai"
      class="top-panel hidden rounded-2xl border border-slate-800 bg-[#101b2e] p-8"
    >
      <h3 class="text-2xl font-bold text-white">
        {isDe ? 'Enterprise KI & Multi-Agenten-Systeme' : 'Enterprise AI & Multi-Agent Systems'}
      </h3>

      <p class="mt-4 max-w-4xl text-base leading-relaxed text-slate-400">
        {isDe
          ? 'Produktionsreife KI-Systeme mit LangChain und LangGraph für zustandsbehaftete Orchestrierung, RAG, Governance, Human-in-the-Loop, sichere APIs und clientkontrollierte Datenhaltung.'
          : 'Production AI systems built with LangChain and LangGraph for stateful orchestration, RAG, governance, Human-in-the-Loop controls, secure APIs, and client-owned data.'}
      </p>
    </section>
  </div>
</section>

<style>
  .top-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    border: 1px solid #334155;
    border-radius: 0.5rem;
    background: transparent;
    color: #94a3b8;
    padding: 0.75rem 1.125rem;
    font-size: 0.875rem;
    font-weight: 700;
    transition: all 160ms ease;
  }

  .top-tab:hover {
    border-color: #64748b;
    background: #172033;
    color: #f8fafc;
  }

  .active-top-tab {
    border-color: #818cf8;
    background: linear-gradient(135deg, rgba(30, 64, 175, 0.26), rgba(124, 58, 237, 0.2));
    color: #f8fafc;
  }

  .cloud-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid #334155;
    border-radius: 0.375rem;
    background: transparent;
    color: #94a3b8;
    padding: 0.5rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1rem;
    transition: all 160ms ease;
  }

  .cloud-tab:hover {
    border-color: #64748b;
    background: #172033;
    color: #f8fafc;
  }

  .active-cloud-tab {
    border-color: #3b82f6;
    background: #1e293b;
    color: #f8fafc;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const topTabs = document.querySelectorAll('[data-top-tab]');
    const topPanels = document.querySelectorAll('[data-top-panel]');
    const cloudTabs = document.querySelectorAll('[data-cloud-tab]');
    const cloudPanels = document.querySelectorAll('[data-cloud-panel]');

    topTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-top-tab');

        topTabs.forEach((item) => {
          item.classList.remove('active-top-tab');
          item.setAttribute('aria-selected', 'false');
        });

        topPanels.forEach((panel) => panel.classList.add('hidden'));

        tab.classList.add('active-top-tab');
        tab.setAttribute('aria-selected', 'true');

        document
          .querySelector(`[data-top-panel="${target}"]`)
          ?.classList.remove('hidden');
      });
    });

    cloudTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-cloud-tab');

        cloudTabs.forEach((item) => {
          item.classList.remove('active-cloud-tab');
          item.setAttribute('aria-selected', 'false');
        });

        cloudPanels.forEach((panel) => panel.classList.add('hidden'));

        tab.classList.add('active-cloud-tab');
        tab.setAttribute('aria-selected', 'true');

        document
          .querySelector(`[data-cloud-panel="${target}"]`)
          ?.classList.remove('hidden');
      });
    });
  });
</script>
