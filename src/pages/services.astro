---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout
  title="Services — Salesforce, n8n & Agentic AI"
  description="NexaForce Digital services: Salesforce Cloud implementation, n8n workflow automation, and full-stack agentic AI engineering for enterprises."
>
  <Navbar />
  <div class="pt-32 max-w-7xl mx-auto px-6 pb-24">

    <!-- Salesforce -->
    <section id="salesforce" class="mb-24">
      <span class="text-xs font-semibold text-brand-blue uppercase tracking-widest mb-4 block">Pillar 1</span>
      <h2 class="text-4xl font-bold mb-6">Salesforce Enterprise Cloud</h2>
      <p class="text-brand-steel text-lg max-w-2xl mb-10">We design, implement, and optimize mission-critical Salesforce environments across five specialized domain clouds.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {[
        {
          name: 'Sales Cloud',
          href: '/services/sales-cloud',
          desc: 'Lead-to-Cash optimization, pipeline automation, Apex/LWR architecture, and CPQ integration.',
          outcome: 'Shorten sales cycles and enforce pipeline discipline.'
        },
        {
          name: 'Commerce Cloud',
          href: '/services/commerce-cloud',
          desc: 'Scalable B2B, B2C, and D2C storefronts with unified cart, order, and customer journeys.',
          outcome: 'Convert more digital demand without fragmenting operations.'
        },
        {
          name: 'Data Cloud',
          href: '/services/data-cloud',
          desc: 'Real-time profile resolution, zero-copy Snowflake/BigQuery connectivity, and activation-ready insights.',
          outcome: 'Create a governed customer data foundation.'
        },
        {
          name: 'Health Cloud',
          href: '/services/health-cloud',
          desc: 'Care coordination, operational workflows, EHR/EMR interoperability, and privacy-aware data controls.',
          outcome: 'Improve care operations while maintaining governance.'
        },
        {
          name: 'Financial Services Cloud',
          href: '/services/financial-services-cloud',
          desc: 'Financial 360, onboarding automation, lifecycle workflows, and compliance-oriented case management.',
          outcome: 'Standardize regulated client operations at scale.'
        }
      ].map((service) => (
        <a
          href={service.href}
          class="group relative flex min-h-[260px] flex-col rounded-2xl border border-white/10 bg-white/[0.035] p-7 transition-all duration-300 hover:-translate-y-1 hover:border-brand-blue/70 hover:bg-white/[0.065] hover:shadow-xl hover:shadow-brand-blue/10 focus:outline-none focus:ring-2 focus:ring-brand-blue"
          aria-label={`Explore ${service.name} services`}
        >
          <h3 class="mb-4 text-2xl font-bold text-white">{service.name}</h3>
          <p class="text-sm leading-relaxed text-brand-steel">{service.desc}</p>
    
          <div class="mt-auto pt-6">
            <p class="mb-4 text-xs font-medium uppercase tracking-wider text-slate-400">
              {service.outcome}
            </p>
            <span class="inline-flex items-center gap-2 text-sm font-semibold text-brand-blue">
              Explore service
              <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
            </span>
          </div>
        </a>
      ))}
    </div>
    </section>

    <!-- n8n -->
    <section id="n8n" class="mb-24">
      <span class="text-xs font-semibold text-brand-blue uppercase tracking-widest mb-4 block">Pillar 2</span>
      <h2 class="text-4xl font-bold mb-6">n8n Workflow Automation</h2>
      <p class="text-brand-steel text-lg max-w-2xl mb-10">Self-hosted, cost-predictable workflow automation replacing high-metering SaaS platforms with client-owned infrastructure.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {[
          { name: 'Self-Hosted Deployment', desc: 'High-availability n8n on private VPS or client VPC with full data sovereignty and zero metering costs.' },
          { name: 'Custom Node Development', desc: 'TypeScript custom nodes for proprietary legacy systems, niche databases, and internal SaaS APIs.' },
          { name: 'Event-Driven Orchestration', desc: 'Asynchronous webhooks, message queues, payload transformation, and production-grade error handling.' },
          { name: 'Platform Migration', desc: 'Structured migration from Zapier, Make, or Workato to predictable self-hosted n8n with full workflow parity.' },
        ].map(s => (
          <div class="bg-white/3 border border-white/8 rounded-2xl p-6 hover:border-brand-blue/40 transition-all">
            <h3 class="font-bold text-lg mb-2">{s.name}</h3>
            <p class="text-brand-steel text-sm leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- AI -->
    <section id="ai">
      <span class="text-xs font-semibold text-brand-blue uppercase tracking-widest mb-4 block">Pillar 3</span>
      <h2 class="text-4xl font-bold mb-6">Agentic AI Engineering</h2>
      <p class="text-brand-steel text-lg max-w-2xl mb-10">Stateful multi-agent architectures built on LangChain + LangGraph, deployed on your infrastructure with full observability via LangSmith.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {[
          { name: 'Orchestration Layer', desc: 'LangChain + LangGraph for stateful multi-agent graphs, conditional branching, retries, and Human-in-the-Loop checkpointing.' },
          { name: 'RAG & Knowledge Pipelines', desc: 'pgvector on PostgreSQL for zero lock-in vector storage. Vendor-agnostic embedding abstractions via LangChain.' },
          { name: 'API & Microservice Delivery', desc: 'FastAPI or Node.js/Express backends with LangServe, REST, or WebSocket protocols. OAuth2/JWT enterprise auth.' },
          { name: 'Observability & Governance', desc: 'LangSmith tracing, token budgets, PII redaction, rate limiting, and full audit logs on every agent interaction.' },
        ].map(s => (
          <div class="bg-white/3 border border-white/8 rounded-2xl p-6 hover:border-brand-blue/40 transition-all">
            <h3 class="font-bold text-lg mb-2">{s.name}</h3>
            <p class="text-brand-steel text-sm leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
    </section>

  </div>
  <Footer />
</BaseLayout>
