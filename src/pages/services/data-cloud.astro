---
import SalesforceCloudDetail from '../../components/SalesforceCloudDetail.astro';
---

<SalesforceCloudDetail
  lang="en"
  title="Salesforce Data Cloud Consulting"
  description="NexaForce Digital implements Salesforce Data Cloud as a governed intelligence layer for unified customer profiles, real-time insights, and cross-cloud activation."
  eyebrow="Salesforce Enterprise Cloud"
  heroTitle="Data Cloud implementation for governed customer intelligence and real-time action."
  image="/assets/logos/crm/data-cloud.svg"
  imageAlt="Salesforce Data Cloud"
  suitableFor={[
    'Organizations with customer data across CRM, web, commerce, support, and warehouses',
    'Teams requiring real-time segmentation and identity resolution',
    'Enterprises using Snowflake or BigQuery with activation requirements',
    'Sales, service, and marketing teams operating from incomplete customer context'
  ]}
  scope={[
    'Real-time and batch ingestion from Salesforce, web, commerce, and external systems',
    'Identity resolution, profile unification, consent-aware data handling, and mapping',
    'Zero-copy or governed connectivity patterns with Snowflake and BigQuery',
    'Calculated Insights, segmentation, Flow triggers, and cross-cloud activation',
    'Data-quality monitoring, access controls, retention, and operational ownership'
  ]}
  outcomes={[
    { title: 'Unified', text: 'A more complete and governed view of customer activity.' },
    { title: 'Actionable', text: 'Segments and insights trigger relevant operational and customer actions.' },
    { title: 'Controlled', text: 'Data ownership and integration boundaries remain documented and manageable.' }
  ]}
  architecture={[
    { title: 'Data assessment', text: 'Identify source systems, data quality issues, identity keys, governance, and activation goals.' },
    { title: 'Identity design', text: 'Configure matching, reconciliation, consent, and profile-resolution rules.' },
    { title: 'Activation', text: 'Connect segments and insights to Sales, Service, Marketing, and external endpoints.' },
    { title: 'Governance', text: 'Document ownership, retention, permissions, and operational monitoring.' }
  ]}
/>
