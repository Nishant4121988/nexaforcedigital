---
import SalesforceCloudDetail from '../../components/SalesforceCloudDetail.astro';
---

<SalesforceCloudDetail
  lang="en"
  title="Salesforce Sales Cloud Consulting"
  description="NexaForce Digital designs Salesforce Sales Cloud architecture for controlled lead-to-cash execution, pipeline visibility, and revenue operations."
  eyebrow="Salesforce Enterprise Cloud"
  heroTitle="Sales Cloud architecture for controlled revenue execution."
  image="/assets/logos/crm/sales-cloud.svg"
  imageAlt="Salesforce Sales Cloud"
  suitableFor={[
    'B2B sales organizations with fragmented pipeline processes',
    'Revenue operations teams requiring trustworthy forecasting',
    'Companies integrating CPQ, ERP, marketing, and service platforms',
    'Sales teams scaling beyond spreadsheets or legacy CRM customization'
  ]}
  scope={[
    'Lead, account, contact, opportunity, territory, and forecast data-model design',
    'Salesforce Flow automation, Apex extensions where required, and approval controls',
    'Pipeline-quality rules, forecast structure, dashboards, and operational reporting',
    'CPQ, billing, ERP, marketing, and service integration architecture',
    'Role hierarchy, sharing rules, permission sets, auditability, and release governance'
  ]}
  outcomes={[
    { title: 'Standardized', text: 'One consistent revenue process across teams, regions, and sales motions.' },
    { title: 'Visible', text: 'Reliable pipeline and forecast signals for operational decisions.' },
    { title: 'Automated', text: 'Less manual administration and more customer-facing selling time.' }
  ]}
  architecture={[
    { title: 'Discovery', text: 'Map revenue processes, data quality, integration dependencies, and operating constraints.' },
    { title: 'Architecture', text: 'Define data model, security, automation boundaries, and API contracts.' },
    { title: 'Delivery', text: 'Build through tested Flow, Apex, LWR, CI/CD, and release controls.' },
    { title: 'Operations', text: 'Document ownership, monitoring, support, and continuous improvement.' }
  ]}
/>
