---
import SalesforceCloudDetail from '../../components/SalesforceCloudDetail.astro';
---

<SalesforceCloudDetail
  lang="en"
  title="Salesforce Commerce Cloud Consulting"
  description="NexaForce Digital designs B2B, B2C, and D2C Commerce Cloud architecture connecting storefronts, pricing, payments, inventory, orders, and fulfillment."
  eyebrow="Salesforce Enterprise Cloud"
  heroTitle="Commerce Cloud architecture for connected B2B, B2C, and D2C operations."
  image="/assets/logos/crm/commerce-cloud.svg"
  imageAlt="Salesforce Commerce Cloud"
  suitableFor={[
    'B2B organizations with account-specific pricing and purchase-order flows',
    'Consumer brands requiring high-performance storefront experiences',
    'D2C businesses operating subscription and loyalty journeys',
    'Companies consolidating fragmented commerce and order systems'
  ]}
  scope={[
    'B2B account hierarchies, buyer roles, contract pricing, quick order, and PO checkout',
    'B2C and D2C storefront architecture, headless APIs, checkout, payments, and loyalty',
    'Catalog, pricing, promotion, cart, subscription, and order-lifecycle design',
    'ERP, inventory, fulfillment, tax, payment-gateway, and CRM integrations',
    'API resilience, observability, and multi-channel order-management controls'
  ]}
  outcomes={[
    { title: 'Connected', text: 'Customer, order, pricing, and inventory data work through one controlled commerce ecosystem.' },
    { title: 'Scalable', text: 'Architecture supports new channels, markets, and commercial models.' },
    { title: 'Conversion-focused', text: 'Buyer journeys are optimized around the actual purchasing model.' }
  ]}
  architecture={[
    { title: 'Commerce model', text: 'Define B2B, B2C, or D2C requirements, product data, and commercial rules.' },
    { title: 'Headless delivery', text: 'Separate storefront experience from APIs where performance and flexibility require it.' },
    { title: 'Integration', text: 'Connect ERP, inventory, tax, payments, fulfillment, and CRM through controlled interfaces.' },
    { title: 'Operations', text: 'Provide monitoring, error handling, release governance, and support documentation.' }
  ]}
/>
