  description="NexaForce Digital designs Financial Services Cloud architecture for wealth management, banking, insurance, onboarding, service, and regulated customer operations."
  eyebrow="Salesforce Enterprise Cloud"
  heroTitle="Financial Services Cloud architecture for controlled client lifecycle operations."
  image="/assets/logos/crm/financial-services-cloud.svg"
  imageAlt="Salesforce Financial Services Cloud"
  suitableFor={[
    'Wealth-management and advisory organizations',
    'Banking, lending, and financial-service operations',
    'Insurance and regulated client-service teams',
    'Organizations modernizing onboarding, service, and compliance workflows'
  ]}
  scope={[
    'Financial account, household, relationship, interaction, and service data-model architecture',
    'Client onboarding, KYC-supporting workflows, case management, and service automation',
    'Financial 360 views, relationship insights, task orchestration, and advisor workflows',
    'Core-banking, portfolio, document-management, e-signature, and compliance integrations',
    'Role-based access, audit controls, approval processes, and operational reporting'
  ]}
  outcomes={[
    { title: 'Unified', text: 'A clearer client and relationship view across advisory, service, and operations teams.' },
    { title: 'Controlled', text: 'Lifecycle processes support traceability, approval, and predictable execution.' },
    { title: 'Efficient', text: 'Less manual re-entry and more consistent service delivery in regulated operations.' }
  ]}
  architecture={[
    { title: 'Process mapping', text: 'Map onboarding, servicing, advisory, case, and compliance workflows before configuration.' },
    { title: 'Financial 360', text: 'Design reliable client, household, relationship, and service information models.' },
    { title: 'Integration', text: 'Connect core banking, portfolio, document, and compliance systems through governed APIs.' },
    { title: 'Operations', text: 'Establish access control, auditability, release discipline, and measurable ownership.' }
  ]}
/>
