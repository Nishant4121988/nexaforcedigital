---
import SalesforceCloudDetail from '../../components/SalesforceCloudDetail.astro';
---

<SalesforceCloudDetail
  lang="en"
  title="Salesforce Health Cloud Consulting"
  description="NexaForce Digital designs Salesforce Health Cloud architecture for connected care operations, patient-service workflows, and controlled EHR/EMR interoperability."
  eyebrow="Salesforce Enterprise Cloud"
  heroTitle="Health Cloud architecture for governed, connected care operations."
  image="/assets/logos/crm/health-cloud.svg"
  imageAlt="Salesforce Health Cloud"
  suitableFor={[
    'Healthcare and care-service organizations',
    'Patient-service and case-management teams',
    'Organizations requiring EHR or EMR integration',
    'Regulated operating models with strong governance requirements'
  ]}
  scope={[
    'Care-plan, case, referral, and patient-service workflow design',
    'EHR and EMR interoperability through REST, FHIR, HL7, or middleware patterns',
    'Role-based access, consent-aware processes, audit controls, and retention policies',
    'Patient and provider communication, task orchestration, and SLA escalation',
    'Operational analytics for care coordination, service delivery, and workload visibility'
  ]}
  outcomes={[
    { title: 'Connected', text: 'Care teams and operational data work through clearer end-to-end workflows.' },
    { title: 'Governed', text: 'Access, integration, and process behavior are designed for traceability.' },
    { title: 'Actionable', text: 'Operational teams gain usable visibility across cases, services, and escalations.' }
  ]}
  architecture={[
    { title: 'Assessment', text: 'Assess service workflows, EHR and EMR dependencies, access requirements, and operational risk.' },
    { title: 'Governance', text: 'Define roles, consent-aware process controls, auditability, and retention expectations.' },
    { title: 'Integration', text: 'Implement documented interfaces with validation, retries, error handling, and observability.' },
    { title: 'Operations', text: 'Establish testing, release, monitoring, support, and ownership practices.' }
  ]}
/>
