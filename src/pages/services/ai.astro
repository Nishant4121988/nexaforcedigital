---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  title="Agentic AI Engineering Services — LangChain, LangGraph & Enterprise AI"
  description="NexaForce Digital AI engineering: LangChain/LangGraph orchestration, RAG pipelines with pgvector, LangSmith observability, and VPC-deployed agentic AI. Berlin-based enterprise consultancy."
>
  <Navbar />

  <!-- Hero -->
  <section class="relative overflow-hidden pt-32 pb-20">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-dark via-[#0d1a3a] to-brand-dark"></div>
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_70%_45%,rgba(30,111,255,0.15),transparent_55%)]"></div>

    <div class="relative mx-auto max-w-7xl px-6">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <span class="mb-4 inline-block rounded-full border border-brand-blue/30 px-4 py-1 text-xs font-semibold uppercase tracking-widest text-brand-blue">
            Pillar 3 · Agentic AI
          </span>

          <h1 class="mb-6 text-4xl font-extrabold leading-tight md:text-5xl lg:text-6xl">
            Full-Stack <span class="text-brand-blue">Agentic AI</span>
          </h1>

          <p class="mb-8 max-w-2xl text-lg leading-relaxed text-brand-steel md:text-xl">
            Stateful multi-agent systems built on LangChain and LangGraph — deployed on your
            infrastructure with complete observability, human oversight, and zero vendor lock-in.
            Enterprise AI that you own and control.
          </p>

          <div class="flex flex-col gap-4 sm:flex-row">
            <a
              href="https://wa.me/4917632246090?text=Hello%20NexaForce%20Digital%2C%20I%20would%20like%20to%20discuss%20Agentic%20AI%20engineering%20for%20our%20enterprise."
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-full bg-brand-blue px-8 py-4 text-center font-semibold text-white shadow-lg shadow-brand-blue/25 transition-all duration-300 hover:bg-blue-500"
            >
              Discuss Your AI Project
            </a>

            <a
              href="/services"
              class="rounded-full border border-white/20 px-8 py-4 text-center font-semibold text-white transition-all duration-300 hover:border-brand-blue"
            >
              ← Back to Services
            </a>
          </div>
        </div>

        <div class="relative flex justify-center lg:justify-end">
          <div class="absolute h-64 w-64 rounded-full bg-brand-blue/20 blur-3xl"></div>
          <div class="relative flex h-48 w-48 items-center justify-center rounded-3xl border border-brand-blue/20 bg-white/5 md:h-64 md:w-64">
            <!-- AI Engineering Logo -->
            <svg class="h-24 w-24 text-brand-blue md:h-32 md:w-32" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
              <circle cx="12" cy="12" r="3" stroke-width="1.5" />
              <path stroke-linecap="round" stroke-width="1.5" d="M12 8v4l2 2" />
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Technologies -->
  <section class="mx-auto max-w-7xl px-6 py-20">
    <div class="mb-12">
      <h2 class="mb-4 text-3xl font-bold md:text-4xl">Our AI Technology Stack</h2>
      <p class="max-w-2xl text-lg text-brand-steel">
        Production-grade tools and frameworks for building, deploying, and monitoring agentic AI systems.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      <div class="group rounded-2xl border border-white/8 bg-white/3 p-8 transition-all duration-300 hover:border-brand-blue/40 hover:bg-white/5">
        <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-blue/15">
          <svg class="h-6 w-6 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
        </div>
        <h3 class="mb-3 text-xl font-bold">LangChain & LangGraph</h3>
        <p class="mb-4 text-sm leading-relaxed text-brand-steel">
          The industry standard for building stateful LLM applications. We architect complex
          multi-agent workflows with conditional branching, parallel execution, and persistent state
          management across long-running conversations.
        </p>
        <ul class="space-y-2 text-sm text-brand-steel">
          <li class="flex items-start gap-2"><span class="mt-1 text-brand-blue">•</span> Multi-agent orchestration with role specialization</li>
          <li class="flex items-start gap-2"><span class="mt-1 text-brand-blue">•</span> Conditional routing and dynamic tool selection</li>
          <li class="flex items-start gap-2"><span class="mt-1 text-brand-blue">•</span> Checkpointing for resumable long-running tasks</li>
        </ul>
      </div>

      <div class="group rounded-2xl border border-white/8 bg-white/3 p-8 transition-all duration-300 hover:border-brand-blue/40 hover:bg-white/5">
        <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-blue/15">
          <svg class="h-6 w-6 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
          </svg>
        </div>
        <h3 class="mb-3 text-xl font-bold">RAG & Vector Databases</h3>
        <p class="mb-4 text-sm leading-relaxed text-brand-steel">
          Retrieval-Augmented Generation with pgvector on PostgreSQL — zero lock-in vector storage
          that runs in your existing database. Semantic search, hybrid retrieval, and citation-aware
          responses for enterprise knowledge bases.
        </p>
        <ul class="space-y-2 text-sm text-brand-steel">
          <li class="flex items-start gap-2"><span class="mt-1 text-brand-blue">•</span> pgvector on PostgreSQL (no Pinecone/Weaviate lock-in)</li>
          <li class="flex items-start gap-2"><span class="mt-1 text-brand-blue">•</span> Hybrid search (semantic + keyword + metadata filters)</li>
          <li class="flex items-start gap-2"><span class="mt-1 text-brand-blue">•</span> Document chunking and embedding optimization</li>
        </ul>
      </div>

      <div class="group rounded-2xl border border-white/8 bg-white/3 p-8 transition-all duration-300 hover:border-brand-blue/40 hover:bg-white/5">
        <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-blue/15">
          <svg class="h-6 w-6 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
        </div>
        <h3 class="mb-3 text-xl font-bold">LangSmith Observability</h3>
        <p class="mb-4 text-sm leading-relaxed text-brand-steel">
          Full tracing, evaluation, and monitoring for every agent interaction. Debug complex
          multi-step reasoning, track token budgets, and ensure quality with automated evaluations
          and human feedback loops.
        </p>
        <ul class="space-y-2 text-sm text-brand-steel">
          <li class="flex items-start gap-2"><span class="mt-1 text-brand-blue">•</span> End-to-end request tracing across agents</li>
          <li class="flex items-start gap-2"><span class="mt-1 text-brand-blue">•</span> Automated evaluation datasets and regression testing</li>
          <li class="flex items-start gap-2"><span class="mt-1 text-brand-blue">•</span> Cost tracking and performance analytics</li>
        </ul>
      </div>

      <div class="group rounded-2xl border border-white/8 bg-white/3 p-8 transition-all duration-300 hover:border-brand-blue/40 hover:bg-white/5">
        <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-blue/15">
          <svg class="h-6 w-6 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
          </svg>
        </div>
        <h3 class="mb-3 text-xl font-bold">Deployment & Infrastructure</h3>
        <p class="mb-4 text-sm leading-relaxed text-brand-steel">
          LLM-agnostic deployment on your infrastructure — AWS, Azure, GCP, or on-premises.
          FastAPI/Node.js backends with LangServe, REST, or WebSocket protocols. OAuth2/JWT
          enterprise authentication and rate limiting.
        </p>
        <ul class="space-y-2 text-sm text-brand-steel">
          <li class="flex items-start gap-2"><span class="mt-1 text-brand-blue">•</span> OpenAI, Anthropic, Azure OpenAI, or self-hosted models</li>
          <li class="flex items-start gap-2"><span class="mt-1 text-brand-blue">•</span> Docker/Kubernetes deployment with auto-scaling</li>
          <li class="flex items-start gap-2"><span class="mt-1 text-brand-blue">•</span> VPC isolation and private endpoint configuration</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Human-in-the-Loop -->
  <section class="mx-auto max-w-7xl px-6 py-20">
    <div class="rounded-2xl border border-brand-blue/20 bg-gradient-to-br from-brand-blue/10 to-white/[0.02] p-8 md:p-12">
      <div class="grid items-center gap-8 lg:grid-cols-2">
        <div>
          <h2 class="mb-4 text-3xl font-bold">Enterprise-Grade AI Safety</h2>
          <p class="mb-6 text-brand-steel leading-relaxed">
            Agentic AI doesn't mean autonomous without oversight. We build human-in-the-loop
            safeguards into every system — approval workflows, escalation paths, and complete
            audit trails for regulated industries.
          </p>
          <div class="space-y-3">
            <div class="flex items-center gap-3">
              <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-blue/15">
                <svg class="h-4 w-4 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span class="text-sm">Human approval gates for critical actions</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-blue/15">
                <svg class="h-4 w-4 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span class="text-sm">PII redaction and data privacy controls</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-blue/15">
                <svg class="h-4 w-4 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span class="text-sm">Full audit logging for compliance (GDPR, HIPAA, SOC2)</span>
            </div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="rounded-xl border border-white/10 bg-white/5 p-6 text-center">
            <div class="text-3xl font-bold text-brand-blue">100%</div>
            <div class="text-xs text-brand-steel">observable</div>
          </div>
          <div class="rounded-xl border border-white/10 bg-white/5 p-6 text-center">
            <div class="text-3xl font-bold text-brand-blue">0</div>
            <div class="text-xs text-brand-steel">cloud lock-in</div>
          </div>
          <div class="rounded-xl border border-white/10 bg-white/5 p-6 text-center">
            <div class="text-3xl font-bold text-brand-blue">24/7</div>
            <div class="text-xs text-brand-steel">monitoring</div>
          </div>
          <div class="rounded-xl border border-white/10 bg-white/5 p-6 text-center">
            <div class="text-3xl font-bold text-brand-blue">HITL</div>
            <div class="text-xs text-brand-steel">safeguards</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-3xl px-6 py-20 text-center">
    <h2 class="mb-4 text-3xl font-bold">Build AI You Actually Own</h2>
    <p class="mb-8 text-lg text-brand-steel">
      Let's discuss how agentic AI can transform your operations — without surrendering
      control to external platforms.
    </p>
    <a
      href="https://wa.me/4917632246090?text=Hello%20NexaForce%20Digital%2C%20I%20would%20like%20to%20discuss%20Agentic%20AI%20engineering%20for%20our%20enterprise."
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block rounded-full bg-brand-blue px-8 py-4 font-semibold text-white shadow-lg shadow-brand-blue/25 transition-all duration-300 hover:bg-blue-500"
    >
      Book a Strategy Call
    </a>
  </section>

  <Footer />
</BaseLayout>
