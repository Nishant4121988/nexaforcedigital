---
import BaseLayout from '../../layouts/BaseLayout.astro'; 
import CoreCapabilities from '../../components/CoreCapabilities.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  title="Enterprise Salesforce, n8n & Agentische KI-Beratung"
  description="NexaForce Digital — Salesforce Cloud, n8n Workflow-Automatisierung und Agentic AI Engineering für Unternehmen. Berliner Unternehmensberatung mit 100 % Dateneigentum."
>
  <Navbar />

  <!-- Hero -->
  <section class="relative min-h-screen overflow-hidden pt-20">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-dark via-[#0d1a3a] to-brand-dark"></div>
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_70%_45%,rgba(30,111,255,0.18),transparent_55%)]"></div>

    <div class="relative mx-auto grid max-w-7xl items-center gap-14 px-6 py-24 lg:min-h-[calc(100vh-5rem)] lg:grid-cols-2">
      <div class="max-w-3xl">
        <span class="mb-6 inline-block rounded-full border border-brand-blue/30 px-4 py-1 text-xs font-semibold uppercase tracking-widest text-brand-blue">
          Berlin · Enterprise Grade
        </span>

        <h1 class="mb-6 text-5xl font-extrabold leading-tight md:text-6xl lg:text-7xl">
          Enterprise Salesforce.<br />
          <span class="text-brand-blue">Intelligente</span> Automatisierung.<br />
          <span class="text-brand-steel">Agentische KI.</span>
        </h1>

        <p class="mb-10 max-w-2xl text-lg leading-relaxed text-brand-steel md:text-xl">
          Wir entwickeln unternehmenskritische digitale Systeme — Salesforce Cloud,
          n8n Workflow-Engines und zustandsbehaftete KI-Agenten — konzipiert für
          100 % Dateneigentum und ohne Vendor Lock-in.
        </p>

        <div class="flex flex-col gap-4 sm:flex-row">
          <a
            href="https://wa.me/4917632246090?text=Hallo%20NexaForce%20Digital%2C%20ich%20möchte%20einen%20Strategietermin%20vereinbaren."
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full bg-brand-blue px-8 py-4 text-center font-semibold text-white shadow-lg shadow-brand-blue/25 transition-all duration-300 hover:bg-blue-500"
          >
            Strategiegespräch buchen
          </a>

          <a
            href="/de/leistungen"
            class="rounded-full border border-white/20 px-8 py-4 text-center font-semibold text-white transition-all duration-300 hover:border-brand-blue"
          >
            Leistungen entdecken
          </a>
        </div>
      </div>

      <div class="relative flex justify-center lg:justify-end">
        <div class="absolute h-72 w-72 rounded-full bg-brand-blue/20 blur-3xl md:h-96 md:w-96"></div>

        <img
          src="/images/nexaforce-digital-logo.jpg"
          alt="NexaForce Digital — Salesforce, KI-Automatisierung, n8n und Robotik"
          width="730"
          height="730"
          loading="eager"
          fetchpriority="high"
          class="relative w-full max-w-[520px] rounded-3xl border border-brand-blue/20 shadow-2xl shadow-brand-blue/20"
        />
      </div>
    </div>
  </section>

  <CoreCapabilities lang="de" />

  <!-- Core pillars -->
  <section class="mx-auto max-w-7xl px-6 py-24">
    <div class="mb-16 text-center">
      <h2 class="mb-4 text-3xl font-bold md:text-4xl">Unsere drei Kernbereiche</h2>
      <p class="mx-auto max-w-2xl text-lg text-brand-steel">
        Jedes Projekt wird auf Ihre Infrastrukturanforderungen, Datensouveränität und messbare Geschäftsergebnisse zugeschnitten.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <a
        href="/de/leistungen#salesforce"
        class="group block rounded-2xl border border-brand-blue/25 bg-gradient-to-br from-brand-blue/10 to-white/[0.025] p-8 transition-all duration-300 hover:-translate-y-1 hover:border-brand-blue/70 hover:shadow-xl hover:shadow-brand-blue/10"
      >
        <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl border border-brand-blue/30 bg-brand-blue/15">
          <svg class="h-7 w-7 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>
          </svg>
        </div>

        <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-brand-blue">
          Enterprise CRM
        </p>

        <h3 class="mb-4 text-2xl font-bold text-white">Salesforce Enterprise Cloud</h3>

        <p class="mb-6 text-sm leading-relaxed text-brand-steel">
          Geschäftskritische CRM-Architektur für Revenue Operations, Customer Experience,
          Datenaktivierung, Gesundheitswesen und regulierte Finanzdienstleistungen —
          mit Custom Apex, LWR-Storefronts und CPQ-Integration.
        </p>

        <div class="mb-7 flex flex-wrap gap-2">
          {['Sales', 'Commerce', 'Data', 'Health', 'Financial Services'].map((cloud) => (
            <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-medium text-slate-200">
              {cloud}
            </span>
          ))}
        </div>

        <span class="inline-flex items-center gap-2 text-sm font-semibold text-brand-blue">
          Salesforce-Leistungen entdecken
          <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
        </span>
      </a>

      <a
        href="/de/leistungen#n8n"
        class="group block rounded-2xl border border-brand-blue/25 bg-gradient-to-br from-brand-blue/10 to-white/[0.025] p-8 transition-all duration-300 hover:-translate-y-1 hover:border-brand-blue/70 hover:shadow-xl hover:shadow-brand-blue/10"
      >
        <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl border border-brand-blue/30 bg-brand-blue/15">
          <svg class="h-7 w-7 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
        </div>

        <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-brand-blue">
          Workflow-Automatisierung
        </p>

        <h3 class="mb-4 text-2xl font-bold text-white">Enterprise n8n Automatisierung</h3>

        <p class="mb-6 text-sm leading-relaxed text-brand-steel">
          Sichere, selbst gehostete Workflow-Engines als Ersatz für kostenintensive
          Plattformen wie Zapier, Make oder Workato. Ereignisgesteuerte Orchestrierung,
          eigene TypeScript-Nodes für Altsysteme und Queue-Mode-Skalierung — auf
          Infrastruktur, die vollständig Ihnen gehört.
        </p>

        <div class="mb-7 flex flex-wrap gap-2">
          {['Self-Hosted HA', 'Custom Nodes', 'Event-Driven', 'Queue Mode', 'Zero Metering'].map((chip) => (
            <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-medium text-slate-200">
              {chip}
            </span>
          ))}
        </div>

        <span class="inline-flex items-center gap-2 text-sm font-semibold text-brand-blue">
          n8n-Leistungen entdecken
          <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
        </span>
      </a>

      <a
        href="/de/leistungen#ai"
        class="group block rounded-2xl border border-brand-blue/25 bg-gradient-to-br from-brand-blue/10 to-white/[0.025] p-8 transition-all duration-300 hover:-translate-y-1 hover:border-brand-blue/70 hover:shadow-xl hover:shadow-brand-blue/10"
      >
        <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl border border-brand-blue/30 bg-brand-blue/15">
          <svg class="h-7 w-7 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
          </svg>
        </div>

        <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-brand-blue">
          Agentic AI Engineering
        </p>

        <h3 class="mb-4 text-2xl font-bold text-white">Full-Stack Agentische KI</h3>

        <p class="mb-6 text-sm leading-relaxed text-brand-steel">
          Zustandsbehaftete Multi-Agenten-Systeme mit LangChain und LangGraph —
          RAG-Pipelines auf pgvector, vollständige Observierbarkeit über LangSmith,
          Human-in-the-Loop-Absicherung und LLM-agnostisches Deployment in Ihrer
          eigenen VPC. 100 % Dateneigentum.
        </p>

        <div class="mb-7 flex flex-wrap gap-2">
          {['LangGraph', 'RAG / pgvector', 'LangSmith', 'Human-in-the-Loop', 'Cloud-Agnostic'].map((chip) => (
            <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-medium text-slate-200">
              {chip}
            </span>
          ))}
        </div>

        <span class="inline-flex items-center gap-2 text-sm font-semibold text-brand-blue">
          KI-Engineering entdecken
          <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
        </span>
      </a>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="mx-auto max-w-3xl px-6 py-24">
    <div class="mb-12 text-center">
      <h2 class="mb-4 text-3xl font-bold md:text-4xl">Projekt starten</h2>
      <p class="text-brand-steel">
        Beschreiben Sie Ihr Anliegen — wir antworten innerhalb eines Werktages.
      </p>
    </div>

    <form
      action="https://formspree.io/f/mlgqypaj"
      method="POST"
      class="space-y-5 rounded-2xl border border-white/8 bg-white/3 p-8"
    >
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <input
          type="text"
          name="name"
          placeholder="Vollständiger Name"
          required
          class="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-white placeholder-brand-steel focus:border-brand-blue focus:outline-none"
        />

        <input
          type="email"
          name="email"
          placeholder="Geschäftliche E-Mail"
          required
          class="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-white placeholder-brand-steel focus:border-brand-blue focus:outline-none"
        />
      </div>

      <input
        type="text"
        name="company"
        placeholder="Unternehmen"
        class="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-white placeholder-brand-steel focus:border-brand-blue focus:outline-none"
      />

      <textarea
        name="message"
        rows="5"
        placeholder="Beschreiben Sie Ihr Anliegen"
        required
        class="w-full resize-none rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-white placeholder-brand-steel focus:border-brand-blue focus:outline-none"
      ></textarea>

      <button
        type="submit"
        class="w-full rounded-xl bg-brand-blue py-4 font-semibold text-white transition-colors duration-300 hover:bg-blue-500"
      >
        Nachricht senden
      </button>
    </form>
  </section>

  <Footer />
</BaseLayout>
