---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CoreCapabilities from '../../components/CoreCapabilities.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  title="Enterprise Salesforce, n8n & Agentische KI-Beratung"
  description="NexaForce Digital Salesforce Cloud, n8n Workflow-Automatisierung und Agentic AI Engineering für Unternehmen. Berliner Unternehmensberatung mit 100 % Dateneigentum."
>
  <Navbar />

  <!-- Hero -->
  <section class="relative min-h-screen overflow-hidden pt-20">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-dark via-[#0d1a3a] to-brand-dark"></div>
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_70%_45%,rgba(30,111,255,0.18),transparent_55%)]"></div>

    <div class="relative mx-auto grid max-w-7xl items-center gap-14 px-6 py-24 lg:min-h-[calc(100vh-5rem)] lg:grid-cols-2">
      <div class="max-w-3xl">
        <span class="mb-6 inline-block rounded-full border border-brand-blue/30 px-4 py-1 text-xs font-semibold uppercase tracking-widest text-brand-blue">
          Berlin · Enterprise Grade
        </span>

        <h1 class="mb-6 text-5xl font-extrabold leading-tight md:text-6xl lg:text-7xl">
          Enterprise Salesforce.<br />
          <span class="text-brand-blue">Intelligente</span> Automatisierung.<br />
          <span class="text-brand-steel">Agentische KI.</span>
        </h1>

        <p class="mb-6 max-w-2xl text-lg leading-relaxed text-brand-steel md:text-xl">
          Ihre Teams kopieren Daten zwischen Systemen, Angebote dauern Tage, und KI wirkt
          unerreichbar, weil Ihre Daten Ihre Umgebung nicht verlassen dürfen. Wir lösen das —
          mit Salesforce-, n8n- und KI-Systemen, die vollständig Ihnen gehören.
        </p>

        <p class="mb-10 max-w-2xl text-base leading-relaxed text-brand-steel/80">
          Unternehmenskritische digitale Systeme — konzipiert für 100 % Dateneigentum und ohne Vendor Lock-in.
        </p>

        <div class="flex flex-col gap-4 sm:flex-row">
          <a
            href="#contact"
            class="rounded-full bg-brand-blue px-8 py-4 text-center font-semibold text-white shadow-lg shadow-brand-blue/25 transition-all duration-300 hover:bg-blue-500"
          >
            Strategiegespräch buchen
          </a>

          <a
            href="/de/leistungen"
            class="rounded-full border border-white/20 px-8 py-4 text-center font-semibold text-white transition-all duration-300 hover:border-brand-blue"
          >
            Leistungen entdecken
          </a>
        </div>
      </div>

      <div class="relative flex justify-center lg:justify-end">
        <div class="absolute h-72 w-72 rounded-full bg-brand-blue/20 blur-3xl md:h-96 md:w-96"></div>

        <img
          src="/images/nexaforce-digital-logo.jpg"
          alt="NexaForce Digital — Salesforce, KI-Automatisierung, n8n und Robotik"
          width="730"
          height="730"
          loading="eager"
          fetchpriority="high"
          class="relative w-full max-w-[520px] rounded-3xl border border-brand-blue/20 shadow-2xl shadow-brand-blue/20"
        />
      </div>
    </div>
  </section>

  <CoreCapabilities lang="de" />

  <!-- We Run What We Build -->
  <section class="border-y border-white/8 bg-white/[0.02] py-24">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-6 text-center">
        <span class="mb-4 inline-block rounded-full border border-brand-blue/30 px-4 py-1 text-xs font-semibold uppercase tracking-widest text-brand-blue">
          Praxisbeweis · Live-Systeme, die wir betreiben
        </span>
        <h2 class="mb-4 text-3xl font-bold md:text-4xl">Wir betreiben, was wir bauen</h2>
        <p class="mx-auto max-w-2xl text-lg text-brand-steel">
          Das sind keine Demos. Wir betreiben diese automatisierten Systeme selbst —
          dieselben Pipelines, die wir auch für Sie entwerfen und bauen.
        </p>
      </div>

      <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-3">
        <!-- MacroMicroNews -->
        <a
          href="https://www.macromicronews.com"
          target="_blank"
          rel="noopener noreferrer"
          class="group block rounded-2xl border border-white/8 bg-white/3 p-8 transition-all duration-300 hover:-translate-y-1 hover:border-brand-blue/60 hover:shadow-xl hover:shadow-brand-blue/10"
        >
          <div class="mb-5 flex items-center justify-between">
            <span class="rounded-full bg-[#EA4B71]/15 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-[#EA4B71]">n8n · Live</span>
            <span class="text-xs text-brand-steel transition-colors group-hover:text-brand-blue">macromicronews.com ↗</span>
          </div>
          <h3 class="mb-3 text-xl font-bold text-white">MacroMicroNews</h3>
          <p class="mb-5 text-sm leading-relaxed text-brand-steel">
            Eine mehrsprachige Nachrichtenplattform, die sich selbst betreibt. Selbst gehostetes n8n
            erfasst Quellen, orchestriert die Pipeline und veröffentlicht nach Zeitplan in Ghost CMS —
            KI wird ausschließlich zum Umschreiben von Inhalten eingesetzt.
          </p>
          <p class="mb-5 text-xs font-semibold uppercase tracking-widest text-brand-blue">Automatisierung: Erfassung → Orchestrierung → Publishing · KI: nur Umschreiben</p>
          <div class="flex flex-wrap gap-2">
            {['Quellen-Erfassung', 'Orchestrierung', 'Auto-Publishing', 'Ghost CMS'].map((chip) => (
              <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-medium text-slate-300">{chip}</span>
            ))}
          </div>
        </a>

        <!-- Real-World Horror Stories -->
        <a
          href="https://youtube.com/@horrorstories-f6y"
          target="_blank"
          rel="noopener noreferrer"
          class="group block rounded-2xl border border-white/8 bg-white/3 p-8 transition-all duration-300 hover:-translate-y-1 hover:border-brand-blue/60 hover:shadow-xl hover:shadow-brand-blue/10"
        >
          <div class="mb-5 flex items-center justify-between">
            <span class="rounded-full bg-[#EA4B71]/15 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-[#EA4B71]">n8n · Live</span>
            <span class="text-xs text-brand-steel transition-colors group-hover:text-brand-blue">YouTube ↗</span>
          </div>
          <h3 class="mb-3 text-xl font-bold text-white">Real-World Horror Stories</h3>
          <p class="mb-5 text-sm leading-relaxed text-brand-steel">
            Ein narrativer YouTube-Kanal, der vollständig von n8n produziert wird — komplette
            Videoerstellung, Zusammenstellung, Scheduling und Veröffentlichung, alles automatisiert.
          </p>
          <p class="mb-5 text-xs font-semibold uppercase tracking-widest text-brand-blue">Automatisierung: komplette Videoerstellung + Posting · KI: gezielt</p>
          <div class="flex flex-wrap gap-2">
            {['Videoerstellung', 'Zusammenstellung', 'Auto-Scheduling', 'Posting'].map((chip) => (
              <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-medium text-slate-300">{chip}</span>
            ))}
          </div>
        </a>

        <!-- Yog Philosophy -->
        <a
          href="https://youtube.com/@yogphilosphy"
          target="_blank"
          rel="noopener noreferrer"
          class="group block rounded-2xl border border-white/8 bg-white/3 p-8 transition-all duration-300 hover:-translate-y-1 hover:border-brand-blue/60 hover:shadow-xl hover:shadow-brand-blue/10"
        >
          <div class="mb-5 flex items-center justify-between">
            <span class="rounded-full bg-[#EA4B71]/15 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-[#EA4B71]">n8n · Live</span>
            <span class="text-xs text-brand-steel transition-colors group-hover:text-brand-blue">YouTube ↗</span>
          </div>
          <h3 class="mb-3 text-xl font-bold text-white">Yog Philosophy</h3>
          <p class="mb-5 text-sm leading-relaxed text-brand-steel">
            Ein Wellness- und Philosophie-Kanal, betrieben von derselben n8n-Engine — komplette
            Videoerstellung und Publishing-Pipeline, durchgehend automatisiert.
          </p>
          <p class="mb-5 text-xs font-semibold uppercase tracking-widest text-brand-blue">Automatisierung: komplette Videoerstellung + Posting · KI: gezielt</p>
          <div class="flex flex-wrap gap-2">
            {['Videoerstellung', 'Zusammenstellung', 'Publishing-Pipeline', 'Scheduling'].map((chip) => (
              <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-medium text-slate-300">{chip}</span>
            ))}
          </div>
        </a>
      </div>

      <!-- Automation vs AI differentiation -->
      <div class="mx-auto mt-14 max-w-4xl rounded-2xl border border-brand-blue/25 bg-gradient-to-br from-brand-blue/10 to-white/[0.025] p-8 md:p-10">
        <h3 class="mb-3 text-center text-2xl font-bold text-white">Automatisierung ist nicht dasselbe wie KI — und genau das zu unterscheiden ist unsere Aufgabe.</h3>
        <p class="mx-auto mb-8 max-w-2xl text-center text-sm leading-relaxed text-brand-steel">
          Jeder kann ein LLM mit einem Workflow verbinden. Der Wert liegt im Urteilsvermögen:
          was deterministisch automatisiert wird und wo KI ihren Preis wirklich rechtfertigt.
        </p>
        <ul class="grid grid-cols-1 gap-4 md:grid-cols-2">
          <li class="flex gap-3 rounded-xl border border-white/8 bg-white/3 p-5">
            <span class="mt-0.5 text-brand-blue">▹</span>
            <span class="text-sm leading-relaxed text-brand-steel"><span class="font-semibold text-white">Deterministische Automatisierung</span> für Orchestrierung, Scheduling, Retries und Publishing — ohne Halluzinationsrisiko, ohne Kosten pro Aufruf.</span>
          </li>
          <li class="flex gap-3 rounded-xl border border-white/8 bg-white/3 p-5">
            <span class="mt-0.5 text-brand-blue">▹</span>
            <span class="text-sm leading-relaxed text-brand-steel"><span class="font-semibold text-white">KI gezielt eingesetzt</span> — nur dort, wo Urteilsvermögen einen Mehrwert schafft: Umschreiben, Zusammenfassen, Klassifizieren.</span>
          </li>
          <li class="flex gap-3 rounded-xl border border-white/8 bg-white/3 p-5">
            <span class="mt-0.5 text-brand-blue">▹</span>
            <span class="text-sm leading-relaxed text-brand-steel"><span class="font-semibold text-white">Backend für den Produktivbetrieb</span> — Queue-Modus, Worker, Fehlerbehandlung und Observability.</span>
          </li>
          <li class="flex gap-3 rounded-xl border border-white/8 bg-white/3 p-5">
            <span class="mt-0.5 text-brand-blue">▹</span>
            <span class="text-sm leading-relaxed text-brand-steel"><span class="font-semibold text-white">Kostenkontrolle by Design</span> — selbst gehostete Automatisierung läuft ohne Metering; KI-Aufrufe bleiben minimal und messbar.</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Why NexaForce -->
  <section class="mx-auto max-w-7xl px-6 py-24">
    <div class="mb-16 text-center">
      <h2 class="mb-4 text-3xl font-bold md:text-4xl">Warum Unternehmen sich für NexaForce entscheiden</h2>
      <p class="mx-auto max-w-2xl text-lg text-brand-steel">
        Engineering-geführte Umsetzung für Systeme, auf die Ihr Geschäft angewiesen ist — keine Folien.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-2xl border border-white/8 bg-white/3 p-8">
        <h3 class="mb-3 text-lg font-bold text-white">Infrastruktur in Ihrem Eigentum</h3>
        <p class="text-sm leading-relaxed text-brand-steel">Ihre Systeme, Zugangsdaten und Daten bleiben unter Ihrer Kontrolle. Kein Lock-in, keine Blackbox.</p>
      </div>
      <div class="rounded-2xl border border-white/8 bg-white/3 p-8">
        <h3 class="mb-3 text-lg font-bold text-white">Senior-Engineering ohne Berater-Ebenen</h3>
        <p class="text-sm leading-relaxed text-brand-steel">Sie arbeiten direkt mit den Personen, die Ihre Architektur entwerfen und umsetzen — keine Übergaben an Junior-Teams.</p>
      </div>
      <div class="rounded-2xl border border-white/8 bg-white/3 p-8">
        <h3 class="mb-3 text-lg font-bold text-white">KI für den Produktivbetrieb</h3>
        <p class="text-sm leading-relaxed text-brand-steel">Kontrollierte Systeme für reale Betriebsumgebungen — keine Demos.</p>
      </div>
      <div class="rounded-2xl border border-white/8 bg-white/3 p-8">
        <h3 class="mb-3 text-lg font-bold text-white">Transparente Architektur</h3>
        <p class="text-sm leading-relaxed text-brand-steel">Dokumentierte Integrationen, Observability, Auditierbarkeit und wartbarer Code als Standard.</p>
      </div>
    </div>

    <div class="mt-12 rounded-2xl border border-brand-blue/25 bg-gradient-to-br from-brand-blue/10 to-white/[0.025] p-8 md:p-10">
      <div class="grid items-center gap-8 lg:grid-cols-[1fr_auto]">
        <div>
          <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-brand-blue">Wer ist NexaForce Digital?</p>
          <p class="text-sm leading-relaxed text-brand-steel md:text-base">
            Eine Berliner, engineering-geführte Beratung, gegründet von einem Senior Salesforce- und
            Automatisierungsarchitekten. Sie arbeiten direkt mit der Person, die Ihr System entwirft
            und baut — Senior-Engineering ohne Berater-Ebenen.
          </p>
        </div>
        <a
          href="/who-are-we/"
          class="inline-flex items-center gap-2 whitespace-nowrap rounded-full border border-white/20 px-6 py-3 text-sm font-semibold text-white transition-all duration-300 hover:border-brand-blue"
        >
          Mehr über uns
          <span>→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Core pillars -->
  <section class="mx-auto max-w-7xl px-6 py-24">
    <div class="mb-16 text-center">
      <h2 class="mb-4 text-3xl font-bold md:text-4xl">Unsere drei Kernbereiche</h2>
      <p class="mx-auto max-w-2xl text-lg text-brand-steel">
        Jedes Projekt wird auf Ihre Infrastrukturanforderungen, Datensouveränität und messbare Geschäftsergebnisse zugeschnitten.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <a
        href="/de/leistungen#salesforce"
        class="group block rounded-2xl border border-brand-blue/25 bg-gradient-to-br from-brand-blue/10 to-white/[0.025] p-8 transition-all duration-300 hover:-translate-y-1 hover:border-brand-blue/70 hover:shadow-xl hover:shadow-brand-blue/10"
      >
        <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl border border-brand-blue/30 bg-brand-blue/15">
          <svg class="h-7 w-7 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>
          </svg>
        </div>

        <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-brand-blue">
          Enterprise CRM
        </p>

        <h3 class="mb-4 text-2xl font-bold text-white">Salesforce Enterprise Cloud</h3>

        <p class="mb-6 text-sm leading-relaxed text-brand-steel">
          Geschäftskritische CRM-Architektur für Revenue Operations, Customer Experience,
          Datenaktivierung, Gesundheitswesen und regulierte Finanzdienstleistungen —
          mit Custom Apex, LWR-Storefronts und CPQ-Integration.
        </p>

        <div class="mb-7 flex flex-wrap gap-2">
          {['Sales', 'Commerce', 'Data', 'Health', 'Financial Services'].map((cloud) => (
            <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-medium text-slate-200">
              {cloud}
            </span>
          ))}
        </div>

        <span class="inline-flex items-center gap-2 text-sm font-semibold text-brand-blue">
          Salesforce-Leistungen entdecken
          <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
        </span>
      </a>

      <a
        href="/de/leistungen#n8n"
        class="group block rounded-2xl border border-brand-blue/25 bg-gradient-to-br from-brand-blue/10 to-white/[0.025] p-8 transition-all duration-300 hover:-translate-y-1 hover:border-brand-blue/70 hover:shadow-xl hover:shadow-brand-blue/10"
      >
        <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl border border-brand-blue/30 bg-brand-blue/15">
          <svg class="h-7 w-7 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
        </div>

        <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-brand-blue">
          Workflow-Automatisierung
        </p>

        <h3 class="mb-4 text-2xl font-bold text-white">Enterprise n8n Automatisierung</h3>

        <p class="mb-6 text-sm leading-relaxed text-brand-steel">
          Sichere, selbst gehostete Workflow-Engines als Ersatz für kostenintensive
          Plattformen wie Zapier, Make oder Workato. Ereignisgesteuerte Orchestrierung,
          eigene TypeScript-Nodes für Altsysteme und Queue-Mode-Skalierung — auf
          Infrastruktur, die vollständig Ihnen gehört.
        </p>

        <div class="mb-7 flex flex-wrap gap-2">
          {['Self-Hosted HA', 'Custom Nodes', 'Event-Driven', 'Queue Mode', 'Zero Metering'].map((chip) => (
            <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-medium text-slate-200">
              {chip}
            </span>
          ))}
        </div>

        <span class="inline-flex items-center gap-2 text-sm font-semibold text-brand-blue">
          n8n-Leistungen entdecken
          <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
        </span>
      </a>

      <a
        href="/de/leistungen#ai"
        class="group block rounded-2xl border border-brand-blue/25 bg-gradient-to-br from-brand-blue/10 to-white/[0.025] p-8 transition-all duration-300 hover:-translate-y-1 hover:border-brand-blue/70 hover:shadow-xl hover:shadow-brand-blue/10"
      >
        <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl border border-brand-blue/30 bg-brand-blue/15">
          <svg class="h-7 w-7 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
          </svg>
        </div>

        <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-brand-blue">
          Agentic AI Engineering
        </p>

        <h3 class="mb-4 text-2xl font-bold text-white">Full-Stack Agentische KI</h3>

        <p class="mb-6 text-sm leading-relaxed text-brand-steel">
          Zustandsbehaftete Multi-Agenten-Systeme mit LangChain und LangGraph —
          RAG-Pipelines auf pgvector, vollständige Observierbarkeit über LangSmith,
          Human-in-the-Loop-Absicherung und LLM-agnostisches Deployment in Ihrer
          eigenen VPC. 100 % Dateneigentum.
        </p>

        <div class="mb-7 flex flex-wrap gap-2">
          {['LangGraph', 'RAG / pgvector', 'LangSmith', 'Human-in-the-Loop', 'Cloud-Agnostic'].map((chip) => (
            <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-medium text-slate-200">
              {chip}
            </span>
          ))}
        </div>

        <span class="inline-flex items-center gap-2 text-sm font-semibold text-brand-blue">
          KI-Engineering entdecken
          <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
        </span>
      </a>
    </div>
  </section>

  <!-- Kommt Ihnen das bekannt vor -->
  <section class="mx-auto max-w-7xl px-6 py-24">
    <div class="mb-16 text-center">
      <h2 class="mb-4 text-3xl font-bold md:text-4xl">Kommt Ihnen das bekannt vor?</h2>
      <p class="mx-auto max-w-2xl text-lg text-brand-steel">
        Die meisten Projekte beginnen mit einem konkreten operativen Problem — nicht mit einer Technologie-Wunschliste.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <div class="rounded-2xl border border-white/8 bg-white/3 p-8">
        <p class="mb-6 text-base leading-relaxed text-white">"Ihr Vertriebsteam verbringt Stunden mit der Erstellung komplexer Angebote."</p>
        <a href="/de/leistungen/revenue-cloud/" class="inline-flex items-center gap-2 text-sm font-semibold text-brand-blue transition-colors hover:text-blue-300">
          Revenue Cloud & CPQ
          <span>→</span>
        </a>
      </div>
      <div class="rounded-2xl border border-white/8 bg-white/3 p-8">
        <p class="mb-6 text-base leading-relaxed text-white">"Ihr Team kopiert Informationen manuell zwischen Systemen."</p>
        <a href="/de/leistungen/n8n/" class="inline-flex items-center gap-2 text-sm font-semibold text-brand-blue transition-colors hover:text-blue-300">
          n8n Workflow-Automatisierung
          <span>→</span>
        </a>
      </div>
      <div class="rounded-2xl border border-white/8 bg-white/3 p-8">
        <p class="mb-6 text-base leading-relaxed text-white">"Sie möchten KI einsetzen, dürfen aber keine sensiblen Daten in unkontrollierte SaaS-Tools geben."</p>
        <a href="/de/leistungen/ai/" class="inline-flex items-center gap-2 text-sm font-semibold text-brand-blue transition-colors hover:text-blue-300">
          Private, kontrollierte KI
          <span>→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Wie wir arbeiten -->
  <section class="mx-auto max-w-7xl px-6 py-24">
    <div class="mb-16 text-center">
      <h2 class="mb-4 text-3xl font-bold md:text-4xl">Von der Architektur bis zum Produktivbetrieb</h2>
      <p class="mx-auto max-w-2xl text-lg text-brand-steel">
        Ein transparenter, festumrissener Lieferprozess — damit Sie immer wissen, was als Nächstes passiert.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-5">
      <div class="rounded-2xl border border-white/8 bg-white/3 p-6">
        <div class="mb-3 text-2xl font-bold text-brand-blue">01</div>
        <h4 class="mb-2 font-semibold text-white">Analyse</h4>
        <p class="text-xs leading-relaxed text-brand-steel">Wir erfassen Ihre bestehenden Systeme, Geschäftsprozesse, Rahmenbedingungen und Ziele.</p>
      </div>
      <div class="rounded-2xl border border-white/8 bg-white/3 p-6">
        <div class="mb-3 text-2xl font-bold text-brand-blue">02</div>
        <h4 class="mb-2 font-semibold text-white">Architektur</h4>
        <p class="text-xs leading-relaxed text-brand-steel">Wir definieren Zielarchitektur, Integrationen, Sicherheitsgrenzen und Lieferplan.</p>
      </div>
      <div class="rounded-2xl border border-white/8 bg-white/3 p-6">
        <div class="mb-3 text-2xl font-bold text-brand-blue">03</div>
        <h4 class="mb-2 font-semibold text-white">Umsetzung</h4>
        <p class="text-xs leading-relaxed text-brand-steel">Inkrementelle Implementierung mit dokumentierten, wartbaren Engineering-Praktiken.</p>
      </div>
      <div class="rounded-2xl border border-white/8 bg-white/3 p-6">
        <div class="mb-3 text-2xl font-bold text-brand-blue">04</div>
        <h4 class="mb-2 font-semibold text-white">Validierung</h4>
        <p class="text-xs leading-relaxed text-brand-steel">Tests, Observability, Sicherheitskontrollen und Stakeholder-Abnahme vor der Produktion.</p>
      </div>
      <div class="rounded-2xl border border-white/8 bg-white/3 p-6">
        <div class="mb-3 text-2xl font-bold text-brand-blue">05</div>
        <h4 class="mb-2 font-semibold text-white">Betrieb</h4>
        <p class="text-xs leading-relaxed text-brand-steel">Monitoring, Dokumentation, Wissenstransfer und laufende Optimierung.</p>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="mx-auto max-w-3xl px-6 py-24">
    <div class="mb-12 text-center">
      <h2 class="mb-4 text-3xl font-bold md:text-4xl">Projekt starten</h2>
      <p class="text-brand-steel">
        Beschreiben Sie Ihr Anliegen — wir antworten innerhalb eines Werktages.
      </p>
    </div>

    <form
      action="https://formspree.io/f/mlgqypaj"
      method="POST"
      class="space-y-5 rounded-2xl border border-white/8 bg-white/3 p-8"
    >
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <input
          type="text"
          name="name"
          placeholder="Vollständiger Name"
          required
          class="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-white placeholder-brand-steel focus:border-brand-blue focus:outline-none"
        />

        <input
          type="email"
          name="email"
          placeholder="Geschäftliche E-Mail"
          required
          class="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-white placeholder-brand-steel focus:border-brand-blue focus:outline-none"
        />
      </div>

      <input
        type="text"
        name="company"
        placeholder="Unternehmen"
        class="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-white placeholder-brand-steel focus:border-brand-blue focus:outline-none"
      />

      <select
        name="topic"
        required
        class="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-white focus:border-brand-blue focus:outline-none"
      >
        <option value="" disabled selected>Worum geht es?</option>
        <option value="salesforce">Salesforce</option>
        <option value="n8n-automation">Automatisierung / n8n</option>
        <option value="agentic-ai">KI / Agentische KI</option>
        <option value="integration">Integration</option>
        <option value="architektur-review">Architektur-Review</option>
        <option value="sonstiges">Sonstiges</option>
      </select>

      <textarea
        name="message"
        rows="5"
        placeholder="Erzählen Sie uns kurz von Ihrem Projekt"
        required
        class="w-full resize-none rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-white placeholder-brand-steel focus:border-brand-blue focus:outline-none"
      ></textarea>

      <button
        type="submit"
        class="w-full rounded-xl bg-brand-blue py-4 font-semibold text-white transition-colors duration-300 hover:bg-blue-500"
      >
        Nachricht senden
      </button>
    </form>
  </section>

  <Footer />
</BaseLayout>
