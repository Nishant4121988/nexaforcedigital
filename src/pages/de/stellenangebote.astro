---
import BaseLayout from '../../layouts/BaseLayout.astro';

const openJobs = 0;
---

<BaseLayout
  title="Stellenangebote | NexaForce Digital"
  description="Entdecken Sie Karrieremöglichkeiten bei NexaForce Digital. Aktuell gibt es 0 offene Stellen; zukünftige Rollen in Salesforce, KI-Automatisierung und Engineering sind geplant."
>
  <div class="relative isolate overflow-hidden bg-[#07111f] text-white">
    <div class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute left-1/2 top-0 h-[36rem] w-[36rem] -translate-x-1/2 rounded-full bg-cyan-400/15 blur-3xl"></div>
      <div class="absolute bottom-0 right-0 h-[30rem] w-[30rem] rounded-full bg-blue-600/20 blur-3xl"></div>
      <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(148,163,184,0.08)_1px,transparent_1px),linear-gradient(to_bottom,rgba(148,163,184,0.08)_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_at_center,black_35%,transparent_75%)]"></div>
    </div>

    <section class="relative px-6 pb-20 pt-28 sm:px-8 lg:px-12 lg:pb-28 lg:pt-36">
      <div class="mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
        <div>
          <div class="mb-6 inline-flex items-center gap-3 rounded-full border border-cyan-300/20 bg-cyan-300/10 px-4 py-2 text-sm font-semibold text-cyan-100 shadow-lg shadow-cyan-950/20 backdrop-blur">
            <span class="relative flex h-2.5 w-2.5">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-cyan-300 opacity-60"></span>
              <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-cyan-200"></span>
            </span>
            Karriere bei NexaForce Digital
          </div>

          <h1 class="max-w-4xl text-4xl font-black tracking-tight text-white sm:text-6xl lg:text-7xl">
            Gestalten Sie die Zukunft
            <span class="bg-gradient-to-r from-cyan-200 via-sky-300 to-blue-400 bg-clip-text text-transparent">
              intelligenter Unternehmen.
            </span>
          </h1>

          <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300 sm:text-xl">
            Wir arbeiten dort, wo Salesforce-Architektur, Agentic AI und Automatisierung messbare Geschäftsergebnisse schaffen. Heute ist keine Position offen – aber die nächste Mission entsteht bereits.
          </p>

          <div class="mt-10 flex flex-col gap-4 sm:flex-row">
            <a
              href="mailto:contact@nexaforcedigital.com?subject=Initiativbewerbung%20%E2%80%94%20NexaForce%20Digital"
              class="group inline-flex items-center justify-center rounded-2xl bg-cyan-300 px-6 py-4 text-sm font-bold text-slate-950 shadow-xl shadow-cyan-950/30 transition hover:-translate-y-0.5 hover:bg-cyan-200 focus:outline-none focus:ring-2 focus:ring-cyan-200 focus:ring-offset-2 focus:ring-offset-slate-950"
            >
              Initiativbewerbung senden
              <svg class="ml-2 h-4 w-4 transition group-hover:translate-x-1" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
              </svg>
            </a>
            <a
              href="/de/leistungen"
              class="inline-flex items-center justify-center rounded-2xl border border-white/15 bg-white/5 px-6 py-4 text-sm font-bold text-white backdrop-blur transition hover:-translate-y-0.5 hover:border-cyan-200/40 hover:bg-white/10"
            >
              Leistungen entdecken
            </a>
          </div>
        </div>

        <div class="relative">
          <div class="absolute -inset-4 rounded-[2.5rem] bg-gradient-to-br from-cyan-300/25 via-blue-500/15 to-transparent blur-2xl"></div>
          <div class="relative overflow-hidden rounded-[2rem] border border-white/10 bg-white/[0.07] p-6 shadow-2xl shadow-slate-950/40 backdrop-blur-xl sm:p-8">
            <div class="flex items-center justify-between gap-4">
              <div>
                <p class="text-sm font-semibold uppercase tracking-[0.25em] text-cyan-200">Live-Status</p>
                <h2 class="mt-2 text-2xl font-bold text-white">Offene Stellen</h2>
              </div>
              <span class="rounded-full border border-emerald-300/20 bg-emerald-300/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-emerald-200">
                Jetzt aktuell
              </span>
            </div>

            <div class="my-8 rounded-[1.5rem] border border-cyan-200/10 bg-slate-950/50 px-6 py-10 text-center">
              <div class="text-[7rem] font-black leading-none tracking-tighter text-white sm:text-[10rem]">
                {openJobs}
              </div>
              <p class="mt-3 text-lg font-semibold text-slate-300">aktuell verfügbare Positionen</p>
            </div>

            <div class="flex items-start gap-4 rounded-2xl border border-white/10 bg-white/5 p-5">
              <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-cyan-300/15 text-cyan-200">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v-2.4a2.25 2.25 0 0 0-2.25-2.25h-12a2.25 2.25 0 0 0-2.25 2.25v6A2.25 2.25 0 0 0 6 20h12a2.25 2.25 0 0 0 2.25-2.25v-1.5M16 6.75V4.5A2.25 2.25 0 0 0 13.75 2.25h-3.5A2.25 2.25 0 0 0 8 4.5v2.25m8 0H8m8 0h1.5A2.25 2.25 0 0 1 19.75 9v3.75m-15.5 0V9A2.25 2.25 0 0 1 6.5 6.75H8" />
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-white">Heute keine Vakanz. Morgen vielleicht Ihre Mission.</h3>
                <p class="mt-2 text-sm leading-6 text-slate-300">
                  Wir bereiten zukünftige Rollen für Menschen vor, die Verantwortung, elegante Systeme und geschäftlich relevante Probleme schätzen.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="relative border-t border-white/10 px-6 py-16 sm:px-8 lg:px-12 lg:py-24">
      <div class="mx-auto max-w-7xl">
        <div class="max-w-3xl">
          <p class="text-sm font-bold uppercase tracking-[0.3em] text-cyan-200">Zukünftige Missionen</p>
          <h2 class="mt-4 text-3xl font-black tracking-tight text-white sm:text-5xl">
            Diese Art von Arbeit entsteht bei uns.
          </h2>
          <p class="mt-5 text-lg leading-8 text-slate-300">
            Neue Rollen werden mit komplexen Unternehmensherausforderungen verbunden sein – nicht mit Routine-Tickets.
          </p>
        </div>

        <div class="mt-12 grid gap-6 md:grid-cols-3">
          <article class="group rounded-[1.75rem] border border-white/10 bg-white/[0.05] p-7 transition hover:-translate-y-1 hover:border-cyan-200/30 hover:bg-white/[0.08]">
            <div class="mb-6 flex h-13 w-13 items-center justify-center rounded-2xl bg-cyan-300/15 text-cyan-200">
              <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 0 1-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 0 1 4.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0 1 12 15a9.065 9.065 0 0 1-6.23-.693L5 14.5m14.8.8 1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0 1 12 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" />
              </svg>
            </div>
            <p class="text-xs font-bold uppercase tracking-[0.25em] text-cyan-200">Zukünftige Möglichkeit</p>
            <h3 class="mt-3 text-xl font-bold text-white">Salesforce & Revenue Cloud</h3>
            <p class="mt-4 text-sm leading-7 text-slate-300">
              Enterprise-Architektur, CPQ, Billing, Integrationen und kontrollierte Quote-to-Cash-Systeme für komplexe Organisationen.
            </p>
          </article>

          <article class="group rounded-[1.75rem] border border-white/10 bg-white/[0.05] p-7 transition hover:-translate-y-1 hover:border-cyan-200/30 hover:bg-white/[0.08]">
            <div class="mb-6 flex h-13 w-13 items-center justify-center rounded-2xl bg-violet-300/15 text-violet-200">
              <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456Z" />
              </svg>
            </div>
            <p class="text-xs font-bold uppercase tracking-[0.25em] text-violet-200">Zukünftige Möglichkeit</p>
            <h3 class="mt-3 text-xl font-bold text-white">Agentic AI & Automatisierung</h3>
            <p class="mt-4 text-sm leading-7 text-slate-300">
              KI-gestützte Workflows, autonome Geschäftsprozesse, Datenpipelines und Automation mit menschlicher Kontrolle.
            </p>
          </article>

          <article class="group rounded-[1.75rem] border border-white/10 bg-white/[0.05] p-7 transition hover:-translate-y-1 hover:border-cyan-200/30 hover:bg-white/[0.08]">
            <div class="mb-6 flex h-13 w-13 items-center justify-center rounded-2xl bg-blue-300/15 text-blue-200">
              <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" />
              </svg>
            </div>
            <p class="text-xs font-bold uppercase tracking-[0.25em] text-blue-200">Zukünftige Möglichkeit</p>
            <h3 class="mt-3 text-xl font-bold text-white">Full-Stack Engineering</h3>
            <p class="mt-4 text-sm leading-7 text-slate-300">
              Moderne Webanwendungen, APIs, Integrationen, Cloud-Deployment und wartbare Systeme mit Skalierungsanspruch.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="relative px-6 pb-24 sm:px-8 lg:px-12">
      <div class="mx-auto max-w-7xl overflow-hidden rounded-[2rem] border border-cyan-200/15 bg-gradient-to-br from-cyan-300/15 via-blue-500/10 to-white/[0.04] p-8 shadow-2xl shadow-slate-950/30 sm:p-12">
        <div class="grid items-center gap-8 lg:grid-cols-[1fr_auto]">
          <div>
            <p class="text-sm font-bold uppercase tracking-[0.3em] text-cyan-100">Bleiben Sie bereit</p>
            <h2 class="mt-3 text-3xl font-black tracking-tight text-white sm:text-4xl">
              Das Missionsboard ist heute leer.
            </h2>
            <p class="mt-4 max-w-2xl text-base leading-7 text-slate-300">
              Wenn Ihre Erfahrung zu Salesforce-Architektur, intelligenter Automatisierung oder Full-Stack Engineering passt, senden Sie uns gern ein kurzes Profil – und erzählen Sie uns, welche Probleme Sie besonders gern lösen.
            </p>
          </div>
          <a
            href="mailto:contact@nexaforcedigital.com?subject=Initiativbewerbung%20%E2%80%94%20NexaForce%20Digital"
            class="inline-flex items-center justify-center rounded-2xl bg-white px-6 py-4 text-sm font-black text-slate-950 shadow-xl transition hover:-translate-y-0.5 hover:bg-cyan-100"
          >
            contact@nexaforcedigital.com
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
