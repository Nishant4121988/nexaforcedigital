---
import SalesforceCloudDetail from '../../../components/SalesforceCloudDetail.astro';
---

<SalesforceCloudDetail
  lang="de"
  title="Salesforce Commerce Cloud Beratung"
  description="NexaForce Digital entwickelt B2B-, B2C- und D2C-Commerce-Architektur für Storefronts, Preise, Payments, Inventar, Bestellungen und Fulfillment."
  eyebrow="Salesforce Enterprise Cloud"
  heroTitle="Commerce Cloud für vernetzte B2B-, B2C- und D2C-Operationen."
  image="/assets/logos/crm/commerce-cloud.svg"
  imageAlt="Salesforce Commerce Cloud"
  suitableFor={[
    'B2B-Unternehmen mit kundenspezifischen Preisen und Purchase-Order-Prozessen',
    'Marken mit Anforderungen an schnelle Consumer Storefronts',
    'D2C-Geschäfte mit Subscriptions und Loyalty Journeys',
    'Unternehmen, die fragmentierte Commerce- und Order-Systeme konsolidieren'
  ]}
  scope={[
    'B2B-Account-Hierarchien, Buyer-Rollen, Vertragskataloge, Quick Order und PO Checkout',
    'B2C- und D2C-Storefronts, Headless APIs, Checkout, Payments und Loyalty',
    'Katalog-, Preis-, Promotion-, Cart-, Subscription- und Order-Lifecycle-Design',
    'ERP-, Inventory-, Fulfillment-, Tax-, Payment-Gateway- und CRM-Integration',
    'API-Resilienz, Observability und kanalübergreifendes Order Management'
  ]}
  outcomes={[
    { title: 'Vernetzt', text: 'Kunden-, Bestell-, Preis- und Inventardaten arbeiten in einem kontrollierten Commerce-Ökosystem.' },
    { title: 'Skalierbar', text: 'Die Architektur unterstützt neue Kanäle, Märkte und Geschäftsmodelle.' },
    { title: 'Conversion-orientiert', text: 'Buyer Journeys werden für das jeweilige Einkaufsmodell optimiert.' }
  ]}
  architecture={[
    { title: 'Commerce-Modell', text: 'B2B-, B2C- oder D2C-Anforderungen, Produktdaten und kommerzielle Regeln definieren.' },
    { title: 'Headless Delivery', text: 'Storefront und APIs dort trennen, wo Performance und Flexibilität dies erfordern.' },
    { title: 'Integration', text: 'ERP, Bestand, Steuern, Payments, Fulfillment und CRM kontrolliert anbinden.' },
    { title: 'Betrieb', text: 'Monitoring, Fehlerbehandlung, Release Governance und Support-Dokumentation bereitstellen.' }
  ]}
/>
