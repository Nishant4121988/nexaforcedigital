---
import SalesforceCloudDetail from '../../../components/SalesforceCloudDetail.astro';
---

<SalesforceCloudDetail
  lang="de"
  title="Salesforce Sales Cloud Beratung"
  description="NexaForce Digital entwickelt Salesforce Sales Cloud Architektur für kontrollierte Lead-to-Cash-Prozesse, Pipeline-Transparenz und Revenue Operations."
  eyebrow="Salesforce Enterprise Cloud"
  heroTitle="Sales Cloud Architektur für kontrollierte Revenue Operations."
  image="/assets/logos/crm/sales-cloud.svg"
  imageAlt="Salesforce Sales Cloud"
  suitableFor={[
    'B2B-Vertriebsorganisationen mit fragmentierten Pipeline-Prozessen',
    'Revenue-Operations-Teams mit Anforderungen an Forecasting',
    'Unternehmen mit CPQ-, ERP-, Marketing- und Service-Integrationen',
    'Vertriebsteams, die über Tabellen oder gewachsene CRM-Strukturen hinaus skalieren'
  ]}
  scope={[
    'Datenmodell für Leads, Accounts, Kontakte, Opportunities, Territorien und Forecasts',
    'Salesforce Flow, Apex-Erweiterungen bei Bedarf und Freigabekontrollen',
    'Pipeline-Qualitätsregeln, Forecast-Struktur, Dashboards und operatives Reporting',
    'Architektur für CPQ-, Billing-, ERP-, Marketing- und Service-Integrationen',
    'Rollenhierarchie, Sharing Rules, Permission Sets, Auditierbarkeit und Release Governance'
  ]}
  outcomes={[
    { title: 'Standardisiert', text: 'Einheitliche Revenue-Prozesse über Teams, Regionen und Vertriebsmodelle hinweg.' },
    { title: 'Transparent', text: 'Belastbare Pipeline- und Forecast-Signale für operative Entscheidungen.' },
    { title: 'Automatisiert', text: 'Weniger Administration und mehr Zeit für kundenorientierte Vertriebsarbeit.' }
  ]}
  architecture={[
    { title: 'Discovery', text: 'Revenue-Prozesse, Datenqualität, Integrationen und Betriebsgrenzen analysieren.' },
    { title: 'Architektur', text: 'Datenmodell, Security, Automatisierungsgrenzen und API-Verträge definieren.' },
    { title: 'Delivery', text: 'Testbare Umsetzung mit Flow, Apex, LWR, CI/CD und Release Controls.' },
    { title: 'Betrieb', text: 'Verantwortlichkeiten, Monitoring, Support und kontinuierliche Optimierung etablieren.' }
  ]}
/>
