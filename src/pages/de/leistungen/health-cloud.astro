---
import SalesforceCloudDetail from '../../../components/SalesforceCloudDetail.astro';
---

<SalesforceCloudDetail
  lang="de"
  title="Salesforce Health Cloud Beratung"
  description="NexaForce Digital entwickelt Salesforce Health Cloud Architektur für vernetzte Versorgungsprozesse, Patientenservice-Workflows und kontrollierte EHR/EMR-Interoperabilität."
  eyebrow="Salesforce Enterprise Cloud"
  heroTitle="Health Cloud für kontrollierte, vernetzte Versorgungsprozesse."
  image="/assets/logos/crm/health-cloud.svg"
  imageAlt="Salesforce Health Cloud"
  suitableFor={[
    'Versorgungsorganisationen und Gesundheitsdienstleister',
    'Patientenservice- und Case-Management-Teams',
    'Organisationen mit EHR- oder EMR-Integrationsbedarf',
    'Regulierte Betriebsmodelle mit hohen Governance-Anforderungen'
  ]}
  scope={[
    'Versorgungs-, Case-, Referral- und Patientenservice-Workflows',
    'EHR- und EMR-Interoperabilität über REST, FHIR, HL7 oder Middleware',
    'Rollenbasierte Berechtigungen, Consent-orientierte Prozesse, Audit Controls und Retention',
    'Patienten- und Provider-Kommunikation, Aufgabenorchestrierung und SLA-Eskalationen',
    'Operative Analyse für Versorgung, Service Delivery und Auslastung'
  ]}
  outcomes={[
    { title: 'Vernetzt', text: 'Versorgungsteams und operative Daten arbeiten über klarere End-to-End-Prozesse zusammen.' },
    { title: 'Kontrolliert', text: 'Zugriff, Integration und Prozessverhalten sind für Nachvollziehbarkeit gestaltet.' },
    { title: 'Handlungsfähig', text: 'Teams erhalten nutzbare Transparenz über Fälle, Services und Eskalationen.' }
  ]}
  architecture={[
    { title: 'Assessment', text: 'Versorgungsprozesse, EHR- und EMR-Abhängigkeiten, Zugriffe und Risiken analysieren.' },
    { title: 'Governance', text: 'Rollen, Consent-orientierte Kontrollen, Auditierbarkeit und Retention definieren.' },
    { title: 'Integration', text: 'Dokumentierte Schnittstellen mit Validierung, Retries, Fehlerbehandlung und Observability umsetzen.' },
    { title: 'Betrieb', text: 'Tests, Releases, Monitoring, Support und Verantwortlichkeiten für den Langzeitbetrieb etablieren.' }
  ]}
/>
