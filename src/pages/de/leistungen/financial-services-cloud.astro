---
import SalesforceServiceDetailDE from '../../../components/SalesforceServiceDetailDE.astro';

const principles = [
  { title: 'Prozessanalyse', text: 'Onboarding-, Service-, Advisory-, Case- und Compliance-Prozesse vor der Konfiguration abbilden.' },
  { title: 'Financial 360', text: 'Ein belastbares Datenmodell für Kunden, Haushalte, Beziehungen und Service konzipieren.' },
  { title: 'Kontrollierte Integration', text: 'Core-Banking-, Portfolio-, Dokumenten- und Compliance-Systeme über kontrollierte APIs anbinden.' },
  { title: 'Betriebs-Governance', text: 'Zugriffe, Auditierbarkeit, Release-Disziplin und messbare Prozessverantwortung etablieren.' }
];
---

<SalesforceServiceDetailDE
  title="Salesforce Financial Services Cloud Beratung"
  image="/assets/logos/crm/financial-cloud.png"
  imageAlt="Salesforce Financial Services Cloud"
  eyebrow="Salesforce Enterprise Cloud"
  heroTitle="Financial Services Cloud für kontrollierte Kundenlebenszyklus-Prozesse."
  description="Wir entwickeln Financial-Services-Cloud-Umgebungen für Wealth Management, Banking, Insurance und regulierte Service-Modelle, die einheitlichen Kundenkontext und verlässliche Prozesskontrolle benötigen."
  suitableFor={[
    'Wealth-Management- und Advisory-Organisationen',
    'Banking-, Lending- und Financial-Service-Teams',
    'Versicherungen und regulierte Kundenservice-Organisationen',
    'Unternehmen, die Onboarding-, Service- und Compliance-Prozesse modernisieren'
  ]}
  scope={[
    'Architektur für Finanzkonten, Haushalte, Beziehungen, Interaktionen und Service-Daten',
    'Kunden-Onboarding, KYC-unterstützende Abläufe, Case Management und Service-Automatisierung',
    'Financial-360-Sicht, Relationship Insights, Task Orchestration und Advisor Workflows',
    'Integration mit Core Banking, Portfolio, Dokumentenmanagement, E-Signature und Compliance-Systemen',
    'Rollenbasierter Zugriff, Auditkontrollen, Freigabeprozesse und operatives Reporting'
  ]}
  outcomes={[
    { title: 'Vereinheitlicht', text: 'Ein klarer Kunden- und Beziehungsblick für Beratung, Service und Operations.' },
    { title: 'Kontrolliert', text: 'Lifecycle-Prozesse sind für Nachvollziehbarkeit, Freigaben und zuverlässige Ausführung gestaltet.' },
    { title: 'Effizient', text: 'Weniger manuelle Dateneingabe und konsistentere Service Delivery in regulierten Abläufen.' }
  ]}
  principles={principles}
  whatsappMessage="Hallo NexaForce Digital, ich möchte ein Salesforce Financial Services Cloud Projekt besprechen."
/>
