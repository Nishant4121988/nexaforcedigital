---
import SalesforceCloudDetail from '../../../components/SalesforceCloudDetail.astro';
---

<SalesforceCloudDetail
  lang="de"
  title="Salesforce Financial Services Cloud Beratung"
  description="NexaForce Digital entwickelt Financial Services Cloud Architektur für Wealth Management, Banking, Versicherungen, Onboarding, Service und regulierte Kundenprozesse."
  eyebrow="Salesforce Enterprise Cloud"
  heroTitle="Financial Services Cloud für kontrollierte Kundenlebenszyklus-Prozesse."
  image="/assets/logos/crm/financial-services-cloud.svg"
  imageAlt="Salesforce Financial Services Cloud"
  suitableFor={[
    'Wealth-Management- und Advisory-Organisationen',
    'Banking-, Lending- und Financial-Service-Operations',
    'Versicherungen und regulierte Kundenservice-Teams',
    'Unternehmen, die Onboarding-, Service- und Compliance-Prozesse modernisieren'
  ]}
  scope={[
    'Architektur für Finanzkonten, Haushalte, Beziehungen, Interaktionen und Service-Daten',
    'Kunden-Onboarding, KYC-unterstützende Workflows, Case Management und Service-Automatisierung',
    'Financial-360-Sicht, Relationship Insights, Task Orchestration und Advisor Workflows',
    'Integration mit Core Banking, Portfolio, Dokumentenmanagement, E-Signature und Compliance-Systemen',
    'Rollenbasierter Zugriff, Audit Controls, Freigaben und operatives Reporting'
  ]}
  outcomes={[
    { title: 'Vereinheitlicht', text: 'Ein klarer Kunden- und Beziehungsblick für Beratung, Service und Operations.' },
    { title: 'Kontrolliert', text: 'Lifecycle-Prozesse unterstützen Nachvollziehbarkeit, Freigaben und zuverlässige Ausführung.' },
    { title: 'Effizient', text: 'Weniger manuelle Dateneingabe und konsistentere Service Delivery in regulierten Abläufen.' }
  ]}
  architecture={[
    { title: 'Prozessanalyse', text: 'Onboarding-, Service-, Advisory-, Case- und Compliance-Prozesse vor der Konfiguration abbilden.' },
    { title: 'Financial 360', text: 'Belastbare Datenmodelle für Kunden, Haushalte, Beziehungen und Service konzipieren.' },
    { title: 'Integration', text: 'Core-Banking-, Portfolio-, Dokumenten- und Compliance-Systeme über kontrollierte APIs anbinden.' },
    { title: 'Betrieb', text: 'Zugriffskontrolle, Auditierbarkeit, Release-Disziplin und messbare Verantwortung etablieren.' }
  ]}
/>
