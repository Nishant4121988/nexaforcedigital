---
import SalesforceServiceDetailDE from '../../../components/SalesforceServiceDetailDE.astro';

const principles = [
  { title: 'Vertragsmodell', text: 'Vertragstypen, Vorlagen, Klauselbibliotheken, Verpflichtungen, Freigaben und kommerzielle Metadaten eindeutig definieren.' },
  { title: 'Workflow-Kontrolle', text: 'Erstellung, Prüfung, Verhandlung, Redlining, Freigaben, E-Signature und Vertragsabschluss mit klaren Verantwortlichkeiten steuern.' },
  { title: 'Systemintegration', text: 'CRM, Revenue Cloud, Dokumentenerstellung, E-Signature, ERP, Billing und Verlängerungen über kontrollierte Schnittstellen verbinden.' },
  { title: 'Operative Governance', text: 'Zugriffskontrollen, Audit Trails, Obligation Monitoring, Renewal Visibility, Reporting und supportfähige Betriebsprozesse bereitstellen.' }
];
---

<SalesforceServiceDetailDE
  title="Salesforce Contract Lifecycle Management Beratung"
  image="/assets/logos/crm/clm.svg"
  imageAlt="Salesforce Contract Lifecycle Management"
  eyebrow="Salesforce Enterprise Cloud"
  heroTitle="Contract Lifecycle Management für kontrollierte Verträge, Freigaben, Verpflichtungen und Verlängerungen."
  description="Wir implementieren Salesforce-zentrierte CLM-Betriebsmodelle, die kommerzielle Daten, Vertragserstellung, Legal Review, Freigaben, E-Signature, Verpflichtungen und Renewal Management verbinden."
  suitableFor={[
    'Unternehmen mit einer hohen Anzahl an Kunden, Lieferanten, Partner oder kommerziellen Verträgen',
    'Legal und Sales-Teams mit getrennten Dokumenten, E-Mail-Freigaben und manueller Vertragsverfolgung',
    'Organisationen mit Anforderungen an kontrollierte Klauselbibliotheken, Verhandlungstransparenz und Auditierbarkeit',
    'Revenue-Operations-Teams, die Verträge mit Angeboten, Subscriptions, Billing und Verlängerungen verbinden'
  ]}
  scope={[
    'Datenmodell für Vertragstypen, Vorlagen, Klauselbibliotheken, Metadaten und Verpflichtungen',
    'Dokumentenerstellung aus Account-, Opportunity-, Quote-, Produkt- und kommerziellen Daten',
    'Legal Review, Redlining, Freigaben, Verhandlung und Eskalations-Workflow-Architektur',
    'E-Signature, CRM, Revenue-Cloud, ERP, Billing, Dokumentenmanagement und Renewal-Integration',
    'Zugriffskontrollen, Audit Trails, Ablaufalarme, Obligation Tracking, Reporting und Release Governance'
  ]}
  outcomes={[
    { title: 'Schnellere Abschlüsse', text: 'Kommerzielle Teams erstellen und steuern Verträge über konsistente, wiederholbare Workflows.' },
    { title: 'Mehr Kontrolle', text: 'Legal und Operations erhalten Nachvollziehbarkeit über Klauseln, Freigaben, Verpflichtungen und Signaturen.' },
    { title: 'Renewal Visibility', text: 'Ablaufdaten, Verpflichtungen und Verlängerungschancen werden sichtbar, bevor Revenue- oder Compliance-Risiken entstehen.' }
  ]}
  principles={principles}
  whatsappMessage="Hallo NexaMatrix Digital, ich möchte ein Salesforce Contract Lifecycle Management Projekt besprechen."
/>
