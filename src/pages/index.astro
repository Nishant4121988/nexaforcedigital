---
import CoreCapabilities from '../components/CoreCapabilities.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Enterprise Salesforce, n8n & Agentic AI Consultancy"
  description="NexaForce Digital Salesforce Cloud, n8n Workflow Automation, and Agentic AI Engineering. Berlin-based enterprise consultancy with 100% data ownership."
>
  <Navbar />

  <!-- Hero -->
  <section class="relative min-h-screen overflow-hidden pt-20">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-dark via-[#0d1a3a] to-brand-dark"></div>
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_70%_45%,rgba(30,111,255,0.18),transparent_55%)]"></div>

    <div class="relative mx-auto grid max-w-7xl items-center gap-14 px-6 py-24 lg:min-h-[calc(100vh-5rem)] lg:grid-cols-2">
      <div class="max-w-3xl">
        <span class="mb-6 inline-block rounded-full border border-brand-blue/30 px-4 py-1 text-xs font-semibold uppercase tracking-widest text-brand-blue">
          Berlin · Enterprise Grade
        </span>

        <h1 class="mb-6 text-5xl font-extrabold leading-tight md:text-6xl lg:text-7xl">
          Enterprise Salesforce.<br />
          <span class="text-brand-blue">Intelligent</span> Automation.<br />
          <span class="text-brand-steel">Agentic AI.</span>
        </h1>

        <p class="mb-10 max-w-2xl text-lg leading-relaxed text-brand-steel md:text-xl">
          We architect mission-critical digital systems — Salesforce Cloud, n8n Workflow Engines,
          and stateful AI agents engineered for 100% data ownership and zero vendor lock-in.
        </p>

        <div class="flex flex-col gap-4 sm:flex-row">
          <a
            href="#contact"
            class="rounded-full bg-brand-blue px-8 py-4 text-center font-semibold text-white shadow-lg shadow-brand-blue/25 transition-all duration-300 hover:bg-blue-500"
          >
            Book a Strategy Call
          </a>

          <a
            href="/services"
            class="rounded-full border border-white/20 px-8 py-4 text-center font-semibold text-white transition-all duration-300 hover:border-brand-blue"
          >
            Explore Services
          </a>
        </div>
      </div>

      <div class="relative flex justify-center lg:justify-end">
        <div class="absolute h-72 w-72 rounded-full bg-brand-blue/20 blur-3xl md:h-96 md:w-96"></div>

        <img
          src="/images/nexaforce-digital-logo.jpg"
          alt="NexaForce Digital: Salesforce, AI automation, n8n and robotics"
          width="730"
          height="730"
          loading="eager"
          fetchpriority="high"
          class="relative w-full max-w-[520px] rounded-3xl border border-brand-blue/20 shadow-2xl shadow-brand-blue/20"
        />
      </div>
    </div>
  </section>

  <CoreCapabilities />

  <!-- Why NexaForce -->
  <section class="mx-auto max-w-7xl px-6 py-24">
    <div class="mb-16 text-center">
      <h2 class="mb-4 text-3xl font-bold md:text-4xl">Why Enterprise Teams Choose NexaForce</h2>
      <p class="mx-auto max-w-2xl text-lg text-brand-steel">
        Engineering-led delivery for systems that run your business — not slideware.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-2xl border border-white/8 bg-white/3 p-8">
        <h3 class="mb-3 text-lg font-bold text-white">Client-Owned Infrastructure</h3>
        <p class="text-sm leading-relaxed text-brand-steel">Your systems, credentials, and data remain under your control. No lock-in, no black boxes.</p>
      </div>
      <div class="rounded-2xl border border-white/8 bg-white/3 p-8">
        <h3 class="mb-3 text-lg font-bold text-white">Senior Engineering Delivery</h3>
        <p class="text-sm leading-relaxed text-brand-steel">You work directly with the people designing and implementing your architecture — no handoffs to junior teams.</p>
      </div>
      <div class="rounded-2xl border border-white/8 bg-white/3 p-8">
        <h3 class="mb-3 text-lg font-bold text-white">Production-First AI</h3>
        <p class="text-sm leading-relaxed text-brand-steel">Governed systems designed for real operational environments — not demos.</p>
      </div>
      <div class="rounded-2xl border border-white/8 bg-white/3 p-8">
        <h3 class="mb-3 text-lg font-bold text-white">Transparent Architecture</h3>
        <p class="text-sm leading-relaxed text-brand-steel">Documented integrations, observability, auditability, and maintainable code as standard.</p>
      </div>
    </div>

    <div class="mt-12 rounded-2xl border border-brand-blue/25 bg-gradient-to-br from-brand-blue/10 to-white/[0.025] p-8 md:p-10">
      <div class="grid items-center gap-8 lg:grid-cols-[1fr_auto]">
        <div>
          <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-brand-blue">Who is NexaForce Digital?</p>
          <p class="text-sm leading-relaxed text-brand-steel md:text-base">
            A Berlin-based, engineering-led consultancy founded by a senior Salesforce and automation architect.
            You work directly with the person who designs and builds your system — senior engineering,
            without the consultancy layers.
          </p>
        </div>
        <a
          href="/who-are-we/"
          class="inline-flex items-center gap-2 whitespace-nowrap rounded-full border border-white/20 px-6 py-3 text-sm font-semibold text-white transition-all duration-300 hover:border-brand-blue"
        >
          More about us
          <span>→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Core pillars -->
  <section class="mx-auto max-w-7xl px-6 py-24">
    <div class="mb-16 text-center">
      <h2 class="mb-4 text-3xl font-bold md:text-4xl">Our Three Core Pillars</h2>
      <p class="mx-auto max-w-2xl text-lg text-brand-steel">
        Every engagement is scoped to your infrastructure constraints, data sovereignty requirements,
        and measurable business outcomes.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <a
        href="/services#salesforce"
        class="group block rounded-2xl border border-brand-blue/25 bg-gradient-to-br from-brand-blue/10 to-white/[0.025] p-8 transition-all duration-300 hover:-translate-y-1 hover:border-brand-blue/70 hover:shadow-xl hover:shadow-brand-blue/10"
      >
        <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl border border-brand-blue/30 bg-brand-blue/15">
          <svg class="h-7 w-7 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>
          </svg>
        </div>

        <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-brand-blue">
          Enterprise CRM
        </p>

        <h3 class="mb-4 text-2xl font-bold text-white">Salesforce Enterprise Cloud</h3>

        <p class="mb-6 text-sm leading-relaxed text-brand-steel">
          Mission-critical CRM architecture for revenue operations, customer experience,
          data activation, healthcare, and regulated financial services — delivered with
          custom Apex, LWR storefronts, and CPQ integration.
        </p>

        <div class="mb-7 flex flex-wrap gap-2">
          {['Sales', 'Commerce', 'Data', 'Health', 'Financial Services'].map((cloud) => (
            <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-medium text-slate-200">
              {cloud}
            </span>
          ))}
        </div>

        <span class="inline-flex items-center gap-2 text-sm font-semibold text-brand-blue">
          Explore Salesforce services
          <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
        </span>
      </a>

      <a
        href="/services#n8n"
        class="group block rounded-2xl border border-brand-blue/25 bg-gradient-to-br from-brand-blue/10 to-white/[0.025] p-8 transition-all duration-300 hover:-translate-y-1 hover:border-brand-blue/70 hover:shadow-xl hover:shadow-brand-blue/10"
      >
        <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl border border-brand-blue/30 bg-brand-blue/15">
          <svg class="h-7 w-7 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
        </div>

        <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-brand-blue">
          Workflow Automation
        </p>

        <h3 class="mb-4 text-2xl font-bold text-white">Enterprise n8n Automation</h3>

        <p class="mb-6 text-sm leading-relaxed text-brand-steel">
          Secure, self-hosted workflow engines that replace high-metering platforms like
          Zapier, Make, and Workato. Event-driven orchestration, custom TypeScript nodes
          for legacy systems, and queue-mode scaling on infrastructure you fully own.
        </p>

        <div class="mb-7 flex flex-wrap gap-2">
          {['Self-Hosted HA', 'Custom Nodes', 'Event-Driven', 'Queue Mode', 'Zero Metering'].map((chip) => (
            <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-medium text-slate-200">
              {chip}
            </span>
          ))}
        </div>

        <span class="inline-flex items-center gap-2 text-sm font-semibold text-brand-blue">
          Explore n8n services
          <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
        </span>
      </a>

      <a
        href="/services#ai"
        class="group block rounded-2xl border border-brand-blue/25 bg-gradient-to-br from-brand-blue/10 to-white/[0.025] p-8 transition-all duration-300 hover:-translate-y-1 hover:border-brand-blue/70 hover:shadow-xl hover:shadow-brand-blue/10"
      >
        <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl border border-brand-blue/30 bg-brand-blue/15">
          <svg class="h-7 w-7 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
          </svg>
        </div>

        <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-brand-blue">
          Agentic AI Engineering
        </p>

        <h3 class="mb-4 text-2xl font-bold text-white">Full-Stack Agentic AI</h3>

        <p class="mb-6 text-sm leading-relaxed text-brand-steel">
          Stateful multi-agent systems built with LangChain and LangGraph RAG pipelines
          on pgvector, full observability via LangSmith, human-in-the-loop safeguards,
          and LLM-agnostic deployment inside your own VPC. 100% data ownership.
        </p>

        <div class="mb-7 flex flex-wrap gap-2">
          {['LangGraph', 'RAG / pgvector', 'LangSmith', 'Human-in-the-Loop', 'Cloud-Agnostic'].map((chip) => (
            <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-medium text-slate-200">
              {chip}
            </span>
          ))}
        </div>

        <span class="inline-flex items-center gap-2 text-sm font-semibold text-brand-blue">
          Explore AI engineering
          <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
        </span>
      </a>
    </div>
  </section>

  <!-- Does this sound familiar -->
  <section class="mx-auto max-w-7xl px-6 py-24">
    <div class="mb-16 text-center">
      <h2 class="mb-4 text-3xl font-bold md:text-4xl">Does This Sound Familiar?</h2>
      <p class="mx-auto max-w-2xl text-lg text-brand-steel">
        Most engagements start with a concrete operational problem — not a technology wishlist.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <div class="rounded-2xl border border-white/8 bg-white/3 p-8">
        <p class="mb-6 text-base leading-relaxed text-white">"Your sales team spends hours assembling complex quotes."</p>
        <a href="/services/revenue-cloud/" class="inline-flex items-center gap-2 text-sm font-semibold text-brand-blue transition-colors hover:text-blue-300">
          Revenue Cloud & CPQ
          <span>→</span>
        </a>
      </div>
      <div class="rounded-2xl border border-white/8 bg-white/3 p-8">
        <p class="mb-6 text-base leading-relaxed text-white">"Your team copies information between systems by hand."</p>
        <a href="/services/n8n/" class="inline-flex items-center gap-2 text-sm font-semibold text-brand-blue transition-colors hover:text-blue-300">
          n8n Workflow Automation
          <span>→</span>
        </a>
      </div>
      <div class="rounded-2xl border border-white/8 bg-white/3 p-8">
        <p class="mb-6 text-base leading-relaxed text-white">"You want AI, but can't send sensitive data into uncontrolled SaaS tools."</p>
        <a href="/services/ai/" class="inline-flex items-center gap-2 text-sm font-semibold text-brand-blue transition-colors hover:text-blue-300">
          Private, Governed AI
          <span>→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- How we work -->
  <section class="mx-auto max-w-7xl px-6 py-24">
    <div class="mb-16 text-center">
      <h2 class="mb-4 text-3xl font-bold md:text-4xl">From Architecture to Production</h2>
      <p class="mx-auto max-w-2xl text-lg text-brand-steel">
        A transparent, fixed-scope delivery process — so you always know what happens next.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-5">
      <div class="rounded-2xl border border-white/8 bg-white/3 p-6">
        <div class="mb-3 text-2xl font-bold text-brand-blue">01</div>
        <h4 class="mb-2 font-semibold text-white">Discovery</h4>
        <p class="text-xs leading-relaxed text-brand-steel">We map your existing systems, business processes, constraints, and desired outcomes.</p>
      </div>
      <div class="rounded-2xl border border-white/8 bg-white/3 p-6">
        <div class="mb-3 text-2xl font-bold text-brand-blue">02</div>
        <h4 class="mb-2 font-semibold text-white">Architecture</h4>
        <p class="text-xs leading-relaxed text-brand-steel">We define the target architecture, integrations, security boundaries, and delivery plan.</p>
      </div>
      <div class="rounded-2xl border border-white/8 bg-white/3 p-6">
        <div class="mb-3 text-2xl font-bold text-brand-blue">03</div>
        <h4 class="mb-2 font-semibold text-white">Build</h4>
        <p class="text-xs leading-relaxed text-brand-steel">Incremental implementation with documented, maintainable engineering practices.</p>
      </div>
      <div class="rounded-2xl border border-white/8 bg-white/3 p-6">
        <div class="mb-3 text-2xl font-bold text-brand-blue">04</div>
        <h4 class="mb-2 font-semibold text-white">Validate</h4>
        <p class="text-xs leading-relaxed text-brand-steel">Testing, observability, security controls, and stakeholder acceptance before production.</p>
      </div>
      <div class="rounded-2xl border border-white/8 bg-white/3 p-6">
        <div class="mb-3 text-2xl font-bold text-brand-blue">05</div>
        <h4 class="mb-2 font-semibold text-white">Operate</h4>
        <p class="text-xs leading-relaxed text-brand-steel">Monitoring, documentation, knowledge transfer, and ongoing optimization.</p>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="mx-auto max-w-3xl px-6 py-24">
    <div class="mb-12 text-center">
      <h2 class="mb-4 text-3xl font-bold md:text-4xl">Start a Project</h2>
      <p class="text-brand-steel">
        Describe your requirement and we will respond within one business day.
      </p>
    </div>

    <form
      action="https://formspree.io/f/mlgqypaj"
      method="POST"
      class="space-y-5 rounded-2xl border border-white/8 bg-white/3 p-8"
    >
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <input
          type="text"
          name="name"
          placeholder="Full Name"
          required
          class="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-white placeholder-brand-steel focus:border-brand-blue focus:outline-none"
        />

        <input
          type="email"
          name="email"
          placeholder="Business Email"
          required
          class="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-white placeholder-brand-steel focus:border-brand-blue focus:outline-none"
        />
      </div>

      <input
        type="text"
        name="company"
        placeholder="Company"
        class="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-white placeholder-brand-steel focus:border-brand-blue focus:outline-none"
      />

      <select
        name="topic"
        required
        class="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-white focus:border-brand-blue focus:outline-none"
      >
        <option value="" disabled selected>What are you looking to solve?</option>
        <option value="salesforce">Salesforce</option>
        <option value="n8n-automation">Automation / n8n</option>
        <option value="agentic-ai">AI / Agentic AI</option>
        <option value="integration">Integration</option>
        <option value="architecture-review">Architecture review</option>
        <option value="other">Other</option>
      </select>

      <textarea
        name="message"
        rows="5"
        placeholder="Tell us briefly about your project"
        required
        class="w-full resize-none rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-white placeholder-brand-steel focus:border-brand-blue focus:outline-none"
      ></textarea>

      <button
        type="submit"
        class="w-full rounded-xl bg-brand-blue py-4 font-semibold text-white transition-colors duration-300 hover:bg-blue-500"
      >
        Send Message
      </button>
    </form>
  </section>

  <Footer />
</BaseLayout>
