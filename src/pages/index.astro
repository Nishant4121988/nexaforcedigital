---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout
  title="Enterprise Salesforce, n8n & Agentic AI Consultancy"
  description="NexaForce Digital — Salesforce Cloud, n8n Workflow Automation, and Agentic AI Engineering. Berlin-based enterprise consultancy with 100% data ownership."
>
  <Navbar />

  <!-- Hero -->
  <section class="relative min-h-screen flex items-center pt-20 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-dark via-[#0d1a3a] to-brand-dark"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_70%_45%,rgba(30,111,255,0.18),transparent_55%)] pointer-events-none"></div>
  
    <div class="relative max-w-7xl mx-auto px-6 py-24 grid lg:grid-cols-2 gap-14 items-center">
      <div class="max-w-3xl">
        <span class="inline-block text-xs font-semibold text-brand-blue uppercase tracking-widest mb-6 border border-brand-blue/30 rounded-full px-4 py-1">
          Berlin · Enterprise Grade
        </span>
  
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-extrabold leading-tight mb-6">
          Enterprise Salesforce.<br />
          <span class="text-brand-blue">Intelligent</span> Automation.<br />
          <span class="text-brand-steel">Agentic AI.</span>
        </h1>
  
        <p class="text-brand-steel text-lg md:text-xl leading-relaxed mb-10 max-w-2xl">
          We architect mission-critical digital systems — Salesforce Cloud, n8n Workflow Engines,
          and stateful AI agents — engineered for 100% data ownership and zero vendor lock-in.
        </p>
  
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="https://wa.me/4917632246090?text=Hello%20NexaForce%20Digital%2C%20I%20would%20like%20to%20book%20a%20strategy%20call."
            target="_blank"
            rel="noopener noreferrer"
            class="bg-brand-blue hover:bg-blue-500 text-white font-semibold px-8 py-4 rounded-full transition-all duration-300 text-center shadow-lg shadow-brand-blue/25">
            Book a Strategy Call
          </a>
  
          <a href="/services"
            class="border border-white/20 hover:border-brand-blue text-white font-semibold px-8 py-4 rounded-full transition-all duration-300 text-center">
            Explore Services
          </a>
        </div>
      </div>
  
      <div class="relative flex justify-center lg:justify-end">
        <div class="absolute w-72 h-72 md:w-96 md:h-96 rounded-full bg-brand-blue/20 blur-3xl"></div>
  
        <img
          src="/images/nexaforce-digital-logo.jpg"
          alt="NexaForce Digital — Salesforce, AI automation, n8n and robotics"
          width="730"
          height="730"
          class="relative w-full max-w-[520px] rounded-3xl border border-brand-blue/20 shadow-2xl shadow-brand-blue/20 animate-logo-float"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- Pillars Overview -->
  <section class="max-w-7xl mx-auto px-6 py-24">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Our Three Core Pillars</h2>
      <p class="text-brand-steel text-lg max-w-2xl mx-auto">Every engagement is scoped to your infrastructure constraints, data sovereignty requirements, and measurable business outcomes.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Salesforce -->
      <div class="group bg-white/3 border border-white/8 rounded-2xl p-8 hover:border-brand-blue/40 hover:bg-white/5 transition-all duration-300">
        <div class="w-12 h-12 bg-brand-blue/15 rounded-xl flex items-center justify-center mb-6">
          <svg class="w-6 h-6 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/></svg>
        </div>
        <h3 class="text-xl font-bold mb-3">Salesforce Cloud</h3>
        <p class="text-brand-steel text-sm leading-relaxed mb-4">Sales Cloud, Commerce Cloud, Data Cloud, Health Cloud, and Financial Services Cloud — custom Apex, LWR architecture, and CPQ integration.</p>
        <a href="/services#salesforce" class="text-brand-blue text-sm font-medium hover:underline">Learn more →</a>
      </div>
      <!-- n8n -->
      <div class="group bg-white/3 border border-white/8 rounded-2xl p-8 hover:border-brand-blue/40 hover:bg-white/5 transition-all duration-300">
        <div class="w-12 h-12 bg-brand-blue/15 rounded-xl flex items-center justify-center mb-6">
          <svg class="w-6 h-6 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        </div>
        <h3 class="text-xl font-bold mb-3">n8n Workflow Automation</h3>
        <p class="text-brand-steel text-sm leading-relaxed mb-4">Self-hosted, event-driven workflow engines with custom TypeScript nodes. Replace Zapier/Make/Workato with predictable, client-owned infrastructure.</p>
        <a href="/services#n8n" class="text-brand-blue text-sm font-medium hover:underline">Learn more →</a>
      </div>
      <!-- AI -->
      <div class="group bg-white/3 border border-white/8 rounded-2xl p-8 hover:border-brand-blue/40 hover:bg-white/5 transition-all duration-300">
        <div class="w-12 h-12 bg-brand-blue/15 rounded-xl flex items-center justify-center mb-6">
          <svg class="w-6 h-6 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
        </div>
        <h3 class="text-xl font-bold mb-3">Agentic AI Engineering</h3>
        <p class="text-brand-steel text-sm leading-relaxed mb-4">Stateful multi-agent systems built on LangChain + LangGraph. Fully observable via LangSmith. Deployed on your infrastructure with zero cloud lock-in.</p>
        <a href="/services#ai" class="text-brand-blue text-sm font-medium hover:underline">Learn more →</a>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="max-w-3xl mx-auto px-6 py-24">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Start a Project</h2>
      <p class="text-brand-steel">Describe your requirement and we will respond within one business day.</p>
    </div>
    <form
      action="https://formspree.io/f/xvgrolqd"
      method="POST"
      class="space-y-5 bg-white/3 border border-white/8 rounded-2xl p-8"
    >
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <input type="text" name="name" placeholder="Full Name" required class="bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-brand-steel text-sm focus:outline-none focus:border-brand-blue w-full" />
        <input type="email" name="email" placeholder="Business Email" required class="bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-brand-steel text-sm focus:outline-none focus:border-brand-blue w-full" />
      </div>
      <input type="text" name="company" placeholder="Company" class="bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-brand-steel text-sm focus:outline-none focus:border-brand-blue w-full" />
      <textarea name="message" rows="5" placeholder="Describe your requirement" required class="bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-brand-steel text-sm focus:outline-none focus:border-brand-blue w-full resize-none"></textarea>
      <button type="submit" class="w-full bg-brand-blue hover:bg-blue-500 text-white font-semibold py-4 rounded-xl transition-colors duration-300">Send Message</button>
    </form>
  </section>

  <Footer />
</BaseLayout>
