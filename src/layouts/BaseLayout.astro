---
import '../styles/global.css';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const altLang = lang === 'en' ? 'de' : 'en';
const altHref = lang === 'en' ? `https://nexamatrixdigital.com/de/` : `https://nexamatrixdigital.com/`;
const canonicalHref = lang === 'en' ? `https://nexamatrixdigital.com${Astro.url.pathname}` : `https://nexamatrixdigital.com${Astro.url.pathname}`;

const { title, description } = Astro.props;
---
<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0A0F1E" />
  <!-- Theme init: runs before first paint to avoid any flash of the wrong theme -->
  <script is:inline>
    (function () {
      try {
        var saved = localStorage.getItem('nf-theme');
        var light = saved
          ? saved === 'light'
          : window.matchMedia('(prefers-color-scheme: light)').matches;
        if (light) document.documentElement.classList.add('light');
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', light ? '#F2F8FF' : '#0A0F1E');
      } catch (e) {}
    })();
  </script>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <title>{title} | NexaMatrix Digital</title>
  <link rel="canonical" href={canonicalHref} />
  <link rel="alternate" hreflang={lang} href={canonicalHref} />
  <link rel="alternate" hreflang={altLang} href={altHref} />
  <link rel="alternate" hreflang="x-default" href="https://nexamatrixdigital.com/" />
  <!-- Open Graph (Facebook / LinkedIn / WhatsApp link previews) -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="NexaMatrix Digital" />
  <meta property="og:url" content={canonicalHref} />
  <meta property="og:title" content={`${title} | NexaMatrix Digital`} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://nexamatrixdigital.com/images/nexaforce-digital-logo.jpg" />
  <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
  <!-- Twitter/X card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${title} | NexaMatrix Digital`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://nexamatrixdigital.com/images/nexaforce-digital-logo.jpg" />
  <!-- Structured data for search engines & AI -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "NexaMatrix Digital",
    "url": "https://nexamatrixdigital.com",
    "logo": "https://nexamatrixdigital.com/images/nexaforce-digital-logo.jpg",
    "image": "https://nexamatrixdigital.com/images/nexaforce-digital-logo.jpg",
    "description": "Enterprise Salesforce Cloud, n8n workflow automation, and Agentic AI engineering consultancy. Berlin-based, 100% data ownership, zero vendor lock-in.",
    "address": { "@type": "PostalAddress", "addressLocality": "Berlin", "addressCountry": "DE" },
    "telephone": "+4917632246090",
    "areaServed": ["DE", "EU"],
    "priceRange": "€€"
  })} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <!-- Zero tracking scripts. No cookies. GDPR compliant. -->
</head>
<body class="bg-brand-dark text-white font-sans antialiased">
  <slot />

  <!-- Theme toggle logic (shared by EN + DE, button lives in Navbar) -->
  <script is:inline>
    (function () {
      function initThemeToggle() {
        var btn = document.getElementById('theme-toggle');
        if (!btn || btn.dataset.themeInit) return;
        btn.dataset.themeInit = 'true';
        btn.addEventListener('click', function () {
          var root = document.documentElement;
          root.classList.add('theme-anim');
          var isLight = root.classList.toggle('light');
          try { localStorage.setItem('nf-theme', isLight ? 'light' : 'dark'); } catch (e) {}
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', isLight ? '#F2F8FF' : '#0A0F1E');
          window.setTimeout(function () { root.classList.remove('theme-anim'); }, 450);
        });
      }
      initThemeToggle();
      document.addEventListener('astro:page-load', initThemeToggle);
    })();
  </script>

  <!-- WhatsApp Floating Widget -->
  <a
    href="https://wa.me/4917632246090?text=Hello%20NexaMatrix%20Digital%2C%20I%20would%20like%20to%20discuss%20a%20project."
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Contact NexaMatrix Digital on WhatsApp"
    class="fixed bottom-6 right-6 z-50 flex items-center justify-center w-14 h-14 bg-green-500 hover:bg-green-400 rounded-full shadow-2xl transition-all duration-300 hover:scale-110"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" class="w-7 h-7">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
  </a>
</body>
</html>
